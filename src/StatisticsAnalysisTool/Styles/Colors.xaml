    <!--
        HUD glow text styles. Defined here (merged first in App.xaml) rather than in HudStyles.xaml (merged last)
        because StaticResource lookups inside a ResourceDictionary only see keys already loaded at that point in
        the merge order - a style defined in a later dictionary can't be referenced by name from an earlier one.
    -->
    <Style x:Key="Style.Text.Glow.Blue" TargetType="TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Color.Accent.Blue.2}" ShadowDepth="0" BlurRadius="6" Opacity="0.85" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Text.Glow.Red" TargetType="TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Color.Accent.Red.2}" ShadowDepth="0" BlurRadius="6" Opacity="0.85" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Text.Glow.Green" TargetType="TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Color.Accent.Green.2}" ShadowDepth="0" BlurRadius="6" Opacity="0.85" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Text.Glow.Yellow" TargetType="TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Color.Accent.Yellow.1}" ShadowDepth="0" BlurRadius="6" Opacity="0.85" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle brass edge used by Style.Card - evokes Albion's gold-trimmed in-game panels without full ornament -->
    <SolidColorBrush x:Key="SolidColorBrush.Brass" Color="#66A9852F"/>

    <!--
        Display font (Albion theme): Cinzel (OFL, bundled) for titles, navigation and section headers only.
        Body/data text intentionally stays on the default UI font - Cinzel is a display serif and becomes
        unreadable at data sizes, mirroring how the game itself pairs a serif for titles with a plain sans.
    -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Cinzel</FontFamily>

    <!-- Panel background with subtle depth (dark top -> darker bottom) like the game's panels -->
    <LinearGradientBrush x:Key="LinearGradientBrush.CardDepth" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1D1D21" Offset="0" />
        <GradientStop Color="#FF161619" Offset="1" />
    </LinearGradientBrush>

    <!-- Ornamental separator: gold fading out to both sides, used under section titles -->
    <LinearGradientBrush x:Key="LinearGradientBrush.GoldSeparator" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A9852F" Offset="0" />
        <GradientStop Color="#CCD4A94F" Offset="0.5" />
        <GradientStop Color="#00A9852F" Offset="1" />
    </LinearGradientBrush>

    <!--
        Reusable card style (Albion theme: squarer corners + brass border over dark leather, soft shadow).
        Defined here (merged first) rather than HudStyles.xaml (merged last) so earlier-merged dictionaries
        such as DashboardStyles.xaml can reference it via StaticResource.
    -->
    <Style x:Key="Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LinearGradientBrush.CardDepth}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Brass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Albion-style section title: Cinzel, gold, letter-spaced caps feel, for TextBlock headers -->
    <Style x:Key="Style.Title.Albion" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
