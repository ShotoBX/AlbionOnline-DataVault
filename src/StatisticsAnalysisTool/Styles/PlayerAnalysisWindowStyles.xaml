<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Premium combat-summary redesign (visual only - no new bindings, no changed data).
        WPF has no true "blur what's behind this card" glassmorphism for an inline element (there is
        no live backdrop behind these cards to blur), so the glass look here is approximated with
        translucent gradient fills, a bright top border highlight, and soft accent glows instead.
        Fade-in/hover animations always animate FROM their explicit start value TO the resting value
        and leave the base Opacity/Scale at their normal (1) default, so a card is never left
        permanently invisible if its Loaded event were ever skipped.
    -->

    <!-- ============================================================
         Header metric chips (DPS / Total value, shown top-right of the player card)
    ============================================================= -->
    <Style x:Key="CombatSummary.MetricChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Hover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="MinWidth" Value="80" />
    </Style>
    <Style x:Key="CombatSummary.MetricChipLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CombatSummary.MetricChipValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ============================================================
         Player avatar (header) - larger, with a soft accent glow ring
    ============================================================= -->
    <Style x:Key="CombatSummary.Avatar" TargetType="Border">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Color.Accent.Blue.4}" Offset="0" />
                    <GradientStop Color="{StaticResource Color.Background.4}" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Color.Accent.Blue.3}" ShadowDepth="0" BlurRadius="14" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CombatSummary.AvatarInitial" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Player name + combat-duration pill badge -->
    <Style x:Key="CombatSummary.PlayerName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CombatSummary.DurationBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="CombatSummary.DurationBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Cyan.2}" />
    </Style>

    <!-- ============================================================
         Rounded, gradient-capable progress bar (replaces the flat-rectangle default template)
         Keeps the standard PART_Track/PART_Indicator contract so WPF's built-in
         Value-to-width sizing logic keeps working exactly as before.
    ============================================================= -->
    <ControlTemplate x:Key="CombatSummary.ProgressBarTemplate" TargetType="ProgressBar">
        <Grid SnapsToDevicePixels="True">
            <Border CornerRadius="5" Background="{TemplateBinding Background}" ClipToBounds="True">
                <Grid>
                    <Rectangle x:Name="PART_Track" Fill="Transparent" />
                    <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                        <Border CornerRadius="5" Background="{TemplateBinding Foreground}" />
                    </Decorator>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ============================================================
         Pill-shaped navigation tabs with a glowing accent border when selected
    ============================================================= -->
    <Style x:Key="CombatSummary.PillTabItem" TargetType="TabItem">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="PillBorder" CornerRadius="18" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <!-- Font scoped to the header presenter, not the TabItem - see note on the implicit TabItem style in HudStyles.xaml -->
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource Font.Display}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.2}" />
                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                            <Setter TargetName="PillBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource Color.Accent.Blue.3}" ShadowDepth="0" BlurRadius="12" Opacity="0.55" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Stat cards (Overview / Stats / Damage Taken / Healing tabs)
    ============================================================= -->
    <Style x:Key="PlayerAnalysis.StatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PlayerAnalysis.StatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="PlayerAnalysis.StatIconBadge" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="PlayerAnalysis.StatAccentLine" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Fade-in on load + hover elevation, shared by every stat card -->
    <Style x:Key="PlayerAnalysis.StatCard" TargetType="Border" BasedOn="{StaticResource Style.Card}">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.92" To="1" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="6" BlurRadius="24" Opacity="0.4" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bigger emphasis variant for the headline metrics (Total Damage / DPS) -->
    <Style x:Key="PlayerAnalysis.StatCard.Primary" TargetType="Border" BasedOn="{StaticResource PlayerAnalysis.StatCard}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Padding" Value="20,18" />
    </Style>

    <DataTemplate x:Key="PlayerAnalysis.TimelineEntryTemplate">
        <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8" Padding="12,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.2" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding Icon, IsAsync=True}" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LocalizationName}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding DamageHealShortString}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.TextSecondary}">
                    <Run Text="{Binding Ticks, Mode=OneWay}" />
                    <Run Text="x" />
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
