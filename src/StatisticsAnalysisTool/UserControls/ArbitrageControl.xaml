<UserControl x:Class="StatisticsAnalysisTool.UserControls.ArbitrageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:trade="clr-namespace:StatisticsAnalysisTool.Trade"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <Style x:Key="Arbitrage.SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Arbitrage.WatchlistChip" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" DataContext="{Binding ArbitrageBindings}">
        <StackPanel Margin="16" Orientation="Vertical">

            <!-- Watchlist -->
            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationWatchlist}" Style="{StaticResource Arbitrage.SectionTitle}" />

                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedItemToAdd, Mode=TwoWay}"
                                  DisplayMemberPath="LocalizedName" IsEditable="True" IsTextSearchEnabled="True"
                                  Width="320" Margin="0,0,10,0" />
                        <Button Content="{x:Static trade:ArbitrageBindings.TranslationAddToWatchlist}" Click="AddToWatchlist_Click" MinWidth="110" Margin="0,0,8,0" />
                        <Button Content="{x:Static trade:ArbitrageBindings.TranslationScan}" Click="ArbitrageScan_Click" MinWidth="110" Margin="0,0,8,0" />
                        <Button Content="{x:Static trade:ArbitrageBindings.TranslationCancel}" Click="ArbitrageCancel_Click"
                                IsEnabled="{Binding IsScanning}" Style="{StaticResource Style.Button.Danger}" MinWidth="110" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                            <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationBuyCity}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding CityFilterLocations}" SelectedItem="{Binding SelectedBuyLocationEntry, Mode=TwoWay}"
                                      DisplayMemberPath="Value" Width="220" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationSellCity}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding CityFilterLocations}" SelectedItem="{Binding SelectedSellLocationEntry, Mode=TwoWay}"
                                      DisplayMemberPath="Value" Width="220" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Watchlist}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Arbitrage.WatchlistChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LocalizedName}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" />
                                        <TextBlock Text=" ×" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   MouseUp="RemoveFromWatchlist_MouseUp" Cursor="Hand" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Scan by category -->
            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationCategoryScan}" Style="{StaticResource Arbitrage.SectionTitle}" />

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                            <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationCategory}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Width="220" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                            <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationTierRange}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding MinTierText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" common:TextBoxHelper.OnlyNumeric="Int" />
                                <TextBlock Text=" - " VerticalAlignment="Center" Margin="6,0,6,0" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                                <TextBox Text="{Binding MaxTierText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" common:TextBoxHelper.OnlyNumeric="Int" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="{x:Static trade:ArbitrageBindings.TranslationScanCategory}" Click="ArbitrageScanCategory_Click"
                                VerticalAlignment="Bottom" MinWidth="140" Height="32" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Best opportunity -->
            <Border Style="{StaticResource Style.Card}" Padding="18,16" Margin="0,0,0,14">
                <Grid>
                    <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationBestOpportunityEmpty}"
                               Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding BestOpportunityEmptyVisibility}" />

                    <StackPanel Orientation="Vertical" Visibility="{Binding BestOpportunityVisibility}">
                        <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationBestOpportunity}" Style="{StaticResource Arbitrage.SectionTitle}" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding BestOpportunity.Icon}" Width="48" Height="48" />
                            <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BestOpportunity.ItemName}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300" />
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="32,0,0,0">
                                <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationBuyAt}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}">
                                    <Run Text="{Binding BestOpportunity.BuyLocationName, Mode=OneWay}" />
                                    <Run Text=" (" /><Run Text="{Binding BestOpportunity.BuyPrice, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="32,0,0,0">
                                <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationSellAt}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}">
                                    <Run Text="{Binding BestOpportunity.SellLocationName, Mode=OneWay}" />
                                    <Run Text=" (" /><Run Text="{Binding BestOpportunity.SellPriceNet, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="32,0,0,0">
                                <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationMargin}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding BestOpportunity.MarginPercent, StringFormat={}{0:N1}%}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Style="{StaticResource Style.Card}" Padding="18">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{x:Static trade:ArbitrageBindings.TranslationArbitrage}" Style="{StaticResource Arbitrage.SectionTitle}" />

                    <ListView ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="45">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="250" DisplayMemberBinding="{Binding ItemName}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="ItemName" Content="{x:Static trade:ArbitrageBindings.TranslationItem}" Click="ResultsColumnHeader_Click" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="180">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="BuyPrice" Content="{x:Static trade:ArbitrageBindings.TranslationBuyAt}" Click="ResultsColumnHeader_Click" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding BuyLocationName, Mode=OneWay}" />
                                                <Run Text=" (" /><Run Text="{Binding BuyPrice, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" /><Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="180">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="SellPriceNet" Content="{x:Static trade:ArbitrageBindings.TranslationSellAt}" Click="ResultsColumnHeader_Click" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding SellLocationName, Mode=OneWay}" />
                                                <Run Text=" (" /><Run Text="{Binding SellPriceNet, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" /><Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="150" DisplayMemberBinding="{Binding MarginPercent, StringFormat={}{0:N1}%}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="MarginPercent" Content="{x:Static trade:ArbitrageBindings.TranslationMargin}" Click="ResultsColumnHeader_Click" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
