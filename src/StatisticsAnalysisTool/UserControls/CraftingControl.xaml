<UserControl x:Class="StatisticsAnalysisTool.UserControls.CraftingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:common="clr-namespace:StatisticsAnalysisTool.Common"
             xmlns:crafting="clr-namespace:StatisticsAnalysisTool.Crafting"
             xmlns:enum="clr-namespace:StatisticsAnalysisTool.Enumerations"
             mc:Ignorable="d"
             d:DesignHeight="1100"
             d:DesignWidth="1300"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <Style x:Key="CraftingResultTile" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Hover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="60" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="CraftingSectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="CraftingEditorLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CraftingSubsectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,10" />
        </Style>
        <Style x:Key="CraftingHeadlineLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="CraftingHeadlineValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CraftingHeadlineProfitValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingHeadlineValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CraftingHeadlineRoiValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingHeadlineValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsRoiPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsRoiNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CraftingHeadlineBreakEvenValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingHeadlineValue}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
        </Style>
        <Style x:Key="CraftingProfitabilityBadge" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPositive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Green.4}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitNegative}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SolidColorBrush.Accent.Red.4}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CraftingProfitabilityBadgeText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CraftingResultLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CraftingResultValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CraftingResultCostValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
        </Style>
        <Style x:Key="CraftingResultRevenueValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
        </Style>
        <Style x:Key="CraftingResultInfoValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
        </Style>
        <Style x:Key="CraftingResultBreakEvenValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
        </Style>
        <Style x:Key="CraftingResultProfitValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CraftingResultRoiValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsRoiPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsRoiNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CraftingResultProfitPerItemValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResultValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPerItemPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPerItemNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SavedCraftingCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SavedCraftingCostText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SavedCraftingCellText}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
        </Style>
        <Style x:Key="SavedCraftingProfitText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SavedCraftingCellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfitPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SavedCraftingProfitPerItemText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SavedCraftingCellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfitPerItemPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProfitPerItemNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SavedCraftingRoiText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SavedCraftingCellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRoiPositive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRoiNegative}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SavedCraftingBreakEvenText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SavedCraftingCellText}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
        </Style>
        <Style x:Key="CraftingResourceQuantityText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CraftingResourceCostText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResourceQuantityText}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
        </Style>
        <Style x:Key="CraftingResourceNetQuantityText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingResourceQuantityText}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Yellow.3}" />
        </Style>
        <Style x:Key="CraftingSellPriceOptionText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.7}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PriceDateStatus}" Value="{x:Static enum:ValueTimeStatus.Normal}">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TimeValue.PastTime.1}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PriceDateStatus}" Value="{x:Static enum:ValueTimeStatus.ToOldFirst}">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TimeValue.PastTime.3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PriceDateStatus}" Value="{x:Static enum:ValueTimeStatus.ToOldSecond}">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TimeValue.PastTime.5}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PriceDateStatus}" Value="{x:Static enum:ValueTimeStatus.ToOldThird}">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TimeValue.PastTime.7}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PriceDateStatus}" Value="{x:Static enum:ValueTimeStatus.NoValue}">
                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.7}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Crafting.DrawerToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="5" Padding="12,7" Background="{StaticResource SolidColorBrush.Background.4}"
                                BorderBrush="{StaticResource SolidColorBrush.Accent.Blue.4}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SolidColorBrush.Accent.Blue.Transparent.3}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Crafting.DrawerClose" TargetType="{x:Type ToggleButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="5" Width="30" Height="30" Background="Transparent">
                            <fa5:ImageAwesome Icon="Solid_Times" Width="14" Height="14" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SavedCraftingListViewItem" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationSavedCraftingLoadTooltip}" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SavedCraftingRow_OnPreviewMouseLeftButtonUp" />
        </Style>
    </UserControl.Resources>
    <TabControl Background="Transparent" BorderThickness="0" PreviewMouseDown="CraftingControl_OnPreviewMouseDown">
        <TabItem Header="{x:Static crafting:CraftingBindings.TranslationItemCrafting}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ================= Toolbar: search + filters + saved-craftings drawer toggle ================= -->
                <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="14,10" Margin="0,0,0,14" Panel.ZIndex="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBox x:Name="CraftingItemSearchTextBox" Text="{Binding CraftingBindings.ItemSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="CraftingItemSearch_OnGotKeyboardFocus"
                                         LostKeyboardFocus="CraftingItemSearch_OnLostKeyboardFocus"
                                         PreviewMouseLeftButtonUp="CraftingItemSearch_OnPreviewMouseLeftButtonUp"
                                         Width="280" TextWrapping="NoWrap" />
                                <Grid Width="34" Height="34" Margin="4,0,0,0" ToolTip="{Binding CraftingBindings.TranslationNew, FallbackValue=NEW}">
                                    <fa5:ImageAwesome Icon="Solid_Redo" Width="14" Height="14" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Cursor="Hand" MouseUp="CraftingItemFilterReset_MouseUp" />
                                </Grid>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding CraftingBindings.ItemShopCategories}"
                                      SelectedItem="{Binding CraftingBindings.SelectedItemShopCategory, Mode=TwoWay}"
                                      SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="140" Margin="0,0,8,0"
                                      ToolTip="{Binding CraftingBindings.TranslationCategory}" />
                            <ComboBox ItemsSource="{Binding CraftingBindings.ItemSubCategories1}"
                                      SelectedItem="{Binding CraftingBindings.SelectedItemShopSubCategory1, Mode=TwoWay}"
                                      SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="140" Margin="0,0,8,0"
                                      ToolTip="{Binding CraftingBindings.TranslationSubcategory1}" />
                            <ComboBox ItemsSource="{Binding CraftingBindings.ItemSubCategories2}"
                                      SelectedItem="{Binding CraftingBindings.SelectedItemShopSubCategory2, Mode=TwoWay}"
                                      SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="140" Margin="0,0,8,0"
                                      ToolTip="{Binding CraftingBindings.TranslationSubcategory2}" />
                            <ComboBox ItemsSource="{Binding CraftingBindings.ItemTiers}"
                                      SelectedValue="{Binding CraftingBindings.SelectedItemTier, Mode=TwoWay}"
                                      SelectedValuePath="Key" DisplayMemberPath="Value" MinWidth="64" Margin="0,0,8,0"
                                      ToolTip="{Binding CraftingBindings.TranslationTier}" />
                            <ComboBox ItemsSource="{Binding CraftingBindings.ItemLevels}"
                                      SelectedValue="{Binding CraftingBindings.SelectedItemLevel, Mode=TwoWay}"
                                      SelectedValuePath="Key" DisplayMemberPath="Value" MinWidth="64"
                                      ToolTip="{Binding CraftingBindings.TranslationItemEnchantment}" />
                        </WrapPanel>

                        <ToggleButton Grid.Column="1" x:Name="SavedCraftingsDrawerToggle" Style="{StaticResource Crafting.DrawerToggle}"
                                      VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Bookmark" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                <TextBlock Text="{Binding CraftingBindings.TranslationSavedCraftings, FallbackValue=SAVED_CRAFTINGS}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Popup PlacementTarget="{Binding ElementName=CraftingItemSearchTextBox}" Placement="Bottom"
                           IsOpen="{Binding CraftingBindings.IsItemSearchPopupOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                    Style="{StaticResource Style.Card}" Padding="4" Width="420" MaxHeight="520">
                                <ListBox x:Name="CraftingItemSearchListBox"
                                         SelectionMode="Single"
                                         SelectionChanged="ListBoxItemSearch_OnSelectionChanged"
                                         PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                         ItemsSource="{Binding CraftingBindings.ListBoxItemSearchItems}"
                                         Width="420"
                                         MinHeight="38"
                                         MaxHeight="520"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Width="366" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- ================= 3-column workspace: item/config | resources | results ================= -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: item identity + crafting configuration -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="{Binding CraftingBindings.TranslationSelectItemToStart, FallbackValue=CRAFTING_SELECT_ITEM_TO_START}"
                                               Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                               Visibility="{Binding CraftingBindings.SelectedItemEmptyVisibility}" />
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                                Visibility="{Binding CraftingBindings.SelectedItemHeaderVisibility}">
                                        <Image Source="{Binding CraftingBindings.SelectedItem.Icon}" Width="96" Height="96" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CraftingBindings.SelectedItem.LocalizedName}"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="17" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CraftingBindings.SelectedItem.TierLevelString}"
                                                   Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Style="{StaticResource CraftingProfitabilityBadge}">
                                        <Grid>
                                            <TextBlock Text="{Binding CraftingBindings.TranslationProfitable, FallbackValue=CRAFTING_PROFITABLE}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingProfitabilityBadgeText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitPositive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CraftingBindings.TranslationNotProfitable, FallbackValue=CRAFTING_NOT_PROFITABLE}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingProfitabilityBadgeText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CraftingBindings.Calculation.IsProfitNegative}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="—">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingProfitabilityBadgeText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding CraftingBindings.Calculation.IsProfitPositive}" Value="False" />
                                                                    <Condition Binding="{Binding CraftingBindings.Calculation.IsProfitNegative}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding CraftingBindings.TranslationCrafting, FallbackValue=CRAFTING}" Style="{StaticResource CraftingSectionTitle}" />
                                    <TextBlock Text="{Binding CraftingBindings.TranslationCraftingSettingsSection, FallbackValue=CRAFTING_SETTINGS_SECTION}" Style="{StaticResource CraftingSubsectionLabel}" Margin="0,-8,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationNumberOfRuns, FallbackValue=NUMBER_OF_RUNS}" Style="{StaticResource CraftingEditorLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding CraftingBindings.CraftingRuns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Natural" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationFocus, FallbackValue=FOCUS}" Style="{StaticResource CraftingEditorLabel}" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding CraftingBindings.UsesFocus, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationDailyBonusRrr, FallbackValue=DAILY_BONUS_RRR}" Style="{StaticResource CraftingEditorLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CraftingBindings.DailyBonusOptions}"
                                  SelectedItem="{Binding CraftingBindings.SelectedDailyBonus, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Width="100" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationHideoutBonus, FallbackValue=HIDEOUT_BONUS}" Style="{StaticResource CraftingEditorLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CraftingBindings.HideoutBonusOptions}"
                                  SelectedItem="{Binding CraftingBindings.SelectedHideoutBonus, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Width="190" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Margin="0,0,0,10" Panel.ZIndex="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationCraftingLocation, FallbackValue=CRAFTING_LOCATION}" Style="{StaticResource CraftingEditorLabel}" />
                        <Grid Grid.Column="1" HorizontalAlignment="Left">
                            <TextBox x:Name="CraftingLocationSearchTextBox"
                                     Text="{Binding CraftingBindings.CraftingLocationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="190"
                                     TextWrapping="NoWrap"
                                     GotKeyboardFocus="CraftingLocationSearch_OnGotKeyboardFocus" />
                            <Popup PlacementTarget="{Binding ElementName=CraftingLocationSearchTextBox}"
                                   Placement="Bottom"
                                   IsOpen="{Binding CraftingBindings.IsCraftingLocationPopupOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                        Style="{StaticResource Style.Card}"
                                        Padding="4"
                                        Width="320"
                                        MaxHeight="520">
                                    <ListBox SelectionMode="Single"
                                             SelectionChanged="ListBoxCraftingLocation_OnSelectionChanged"
                                             PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                             ItemsSource="{Binding CraftingBindings.ListBoxCraftingLocationItems}"
                                             Width="320"
                                             MinHeight="38"
                                             MaxHeight="520"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical" Margin="4,3">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BonusSummary}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding CraftingBindings.SelectedCraftingLocationBonusSummary}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationReturnRatePercent, FallbackValue=RETURN_RATE_PERCENT}" Style="{StaticResource CraftingEditorLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding CraftingBindings.ReturnRatePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                    </Grid>

                    <TextBlock Text="{Binding CraftingBindings.TranslationPricingFeesSection, FallbackValue=PRICING_FEES_SECTION}" Style="{StaticResource CraftingSubsectionLabel}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationPriceMarket, FallbackValue=PRICE_MARKET}" Style="{StaticResource CraftingEditorLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CraftingBindings.MarketLocations}"
                                  SelectedValue="{Binding CraftingBindings.SelectedMarketLocation, Mode=TwoWay}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value" Width="190" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationStationFee, FallbackValue=STATION_FEE}" Style="{StaticResource CraftingEditorLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding CraftingBindings.StationFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationSalesTaxPercent, FallbackValue=SALES_TAX_PERCENT}" Style="{StaticResource CraftingEditorLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding CraftingBindings.SalesTaxPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationSetupFee, FallbackValue=SETUP_FEE}" Style="{StaticResource CraftingEditorLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding CraftingBindings.SetupFeePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationOtherCosts, FallbackValue=OTHER_COSTS}" Style="{StaticResource CraftingEditorLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding CraftingBindings.OtherCosts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CraftingBindings.TranslationSellPrice, FallbackValue=SELL_PRICE}" Style="{StaticResource CraftingEditorLabel}" />
                        <Grid Grid.Column="1" HorizontalAlignment="Left">
                            <TextBox x:Name="OutputUnitPriceTextBox"
                                     Text="{Binding CraftingBindings.OutputUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100"
                                     common:TextBoxHelper.OnlyNumeric="Double"
                                     GotKeyboardFocus="OutputUnitPrice_OnGotKeyboardFocus"
                                     LostKeyboardFocus="OutputUnitPrice_OnLostKeyboardFocus"
                                     PreviewMouseLeftButtonDown="PriceTextBox_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="OutputUnitPrice_OnPreviewMouseLeftButtonUp" />
                            <Popup PlacementTarget="{Binding ElementName=OutputUnitPriceTextBox}"
                                   Placement="Bottom"
                                   IsOpen="{Binding CraftingBindings.IsSellPricePopupOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                        Style="{StaticResource Style.Card}"
                                        Padding="4"
                                        Width="230"
                                        MaxHeight="360">
                                    <ListBox x:Name="SellPriceOptionsListBox"
                                             SelectionMode="Single"
                                             SelectionChanged="ListBoxSellPrice_OnSelectionChanged"
                                             PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                             ItemsSource="{Binding CraftingBindings.SellPriceOptions}"
                                             Width="230"
                                             MinHeight="38"
                                             MaxHeight="360"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding UpdateDateTimeText}" Style="{StaticResource CraftingSellPriceOptionText}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{Binding CraftingBindings.TranslationNew, FallbackValue=NEW}" MinWidth="72" Command="{Binding CraftingBindings.NewCommand}" />
                        <Button Content="{Binding CraftingBindings.TranslationSave, FallbackValue=SAVE}" MinWidth="72" Margin="8,0,0,0" Command="{Binding CraftingBindings.SaveCommand}" />
                        <Button Content="{Binding CraftingBindings.TranslationDelete, FallbackValue=DELETE}" MinWidth="72" Margin="8,0,0,0"
                                Style="{StaticResource Style.Button.Danger}" Command="{Binding CraftingBindings.DeleteCommand}" />
                        <Button Content="{Binding CraftingBindings.TranslationPrices, FallbackValue=PRICES}" MinWidth="72" Margin="8,0,0,0" Command="{Binding CraftingBindings.LoadPricesCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding CraftingBindings.StatusText}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Style.Card}" Padding="18">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding CraftingBindings.TranslationNotes, FallbackValue=NOTES}" Style="{StaticResource CraftingSectionTitle}" />
                                    <TextBox Text="{Binding CraftingBindings.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Column 2: resources, full available height -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="18">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding CraftingBindings.TranslationResources, FallbackValue=RESOURCES}" Style="{StaticResource CraftingSectionTitle}" />

                                <!-- Multi-city sourcing controls: global-city toggle, purchase optimizer, city-exclusion filter -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding CraftingBindings.UseGlobalCity, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static crafting:CraftingBindings.TranslationUseGlobalCity}" Style="{StaticResource CraftingEditorLabel}" Margin="8,0,20,0" />
                                        <Button Content="{x:Static crafting:CraftingBindings.TranslationOptimizePurchase}" MinWidth="130"
                                                Command="{Binding CraftingBindings.OptimizePurchaseCommand}"
                                                IsEnabled="{Binding CraftingBindings.IsNotOptimizingPurchase}" />
                                    </StackPanel>
                                    <WrapPanel Visibility="{Binding CraftingBindings.PerCitySourcingVisibility}" Margin="0,8,0,0">
                                        <TextBlock Text="{x:Static crafting:CraftingBindings.TranslationExcludedCities}" Style="{StaticResource CraftingEditorLabel}" Margin="0,0,10,4" />
                                        <ItemsControl ItemsSource="{Binding CraftingBindings.SourcingCityFilters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}" Content="{Binding DisplayName}"
                                                              Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="0,0,14,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CraftingBindings.OptimizationSummaryText}" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding CraftingBindings.Resources}" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationIcon}" Width="45">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceIconColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationResource}" Width="250">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceNameColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource SolidColorBrush.Text.1}"
                                                       Cursor="Hand"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       MouseLeftButtonUp="CopyTextBlockTextToClipboard_OnMouseLeftButtonUp" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationType}" Width="125" DisplayMemberBinding="{Binding ResourceKindText}">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceTypeColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationBuyCity}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.CraftingBindings.ResourceMarketLocations, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      SelectedValue="{Binding SourceLocation, Mode=TwoWay}"
                                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                                      Width="135" Height="28"
                                                      IsEnabled="{Binding DataContext.CraftingBindings.IsPerCitySourcingEnabled, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationGross}" Width="80">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceGrossColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GrossQuantity, StringFormat={}{0:#,0.##}}" Style="{StaticResource CraftingResourceQuantityText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationExpectedReturn}" Width="115">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceExpectedReturnColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ExpectedReturnQuantity, StringFormat={}{0:#,0.##}}" Style="{StaticResource CraftingResourceQuantityText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationNet}" Width="80">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceNetColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NetQuantity, StringFormat={}{0:#,0.##}}" Style="{StaticResource CraftingResourceNetQuantityText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationPrice}" Width="110">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourcePriceColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBox x:Name="ResourceUnitPriceTextBox"
                                                         Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="78"
                                                         Height="28"
                                                         Padding="8,2"
                                                         common:TextBoxHelper.OnlyNumeric="Double"
                                                         GotKeyboardFocus="ResourcePrice_OnGotKeyboardFocus"
                                                         PreviewMouseLeftButtonDown="PriceTextBox_OnPreviewMouseLeftButtonDown"
                                                         PreviewMouseLeftButtonUp="ResourcePrice_OnPreviewMouseLeftButtonUp" />
                                                <Popup PlacementTarget="{Binding ElementName=ResourceUnitPriceTextBox}"
                                                       Placement="Bottom"
                                                       IsOpen="{Binding IsPricePopupOpen, Mode=TwoWay}"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Slide">
                                                    <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                            Style="{StaticResource Style.Card}"
                                                            Padding="4"
                                                            Width="230"
                                                            MaxHeight="360">
                                                        <ListBox SelectionMode="Single"
                                                                 SelectionChanged="ListBoxResourcePrice_OnSelectionChanged"
                                                                 PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                                                 ItemsSource="{Binding PriceOptions}"
                                                                 Tag="{Binding}"
                                                                 Width="230"
                                                                 MinHeight="38"
                                                                 MaxHeight="360"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding UpdateDateTimeText}" Style="{StaticResource CraftingSellPriceOptionText}" />
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationNetCost}" Width="110">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="ToolTip" Value="{x:Static crafting:CraftingBindings.TranslationResourceNetCostColumnTooltip}" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NetCost, StringFormat={}{0:N0}}" Style="{StaticResource CraftingResourceCostText}" />
                                                <Image Style="{StaticResource Icon.Silver}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Margin="0,14,0,0" Padding="18">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Style.Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CraftingBindings.HasJournal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="{Binding CraftingBindings.TranslationJournals, FallbackValue=JOURNALS}" Style="{StaticResource CraftingSectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding CraftingBindings.Journal.Icon}" Width="36" Height="36" />
                                <StackPanel Orientation="Vertical" Margin="10,0,0,0" >
                                    <TextBlock Text="{Binding CraftingBindings.Journal.DisplayName}" Foreground="{StaticResource SolidColorBrush.Text.1}"
                                               Cursor="Hand"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               MouseLeftButtonUp="CopyTextBlockTextToClipboard_OnMouseLeftButtonUp" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" MinWidth="80">
                                            <TextBlock Text="{Binding CraftingBindings.TranslationEmpty, Mode=OneWay, FallbackValue=EMPTY}" 
                                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}" />
                                            <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}" />
                                            <TextBlock Text="{Binding CraftingBindings.Journal.RequiredEmptyJournals, Mode=OneWay, FallbackValue=0}" 
                                                       Foreground="{StaticResource SolidColorBrush.Accent.Yellow.3}" FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" MinWidth="80">
                                            <TextBlock Text="{Binding CraftingBindings.TranslationFull, Mode=OneWay, FallbackValue=FULL}" 
                                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}" />
                                            <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}" />
                                            <TextBlock Text="{Binding CraftingBindings.Journal.ExpectedFullJournals, Mode=OneWay, FallbackValue=0}" 
                                                       Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" MinWidth="120">
                                            <TextBlock Text="{Binding CraftingBindings.TranslationPartial, Mode=OneWay, FallbackValue=PARTIAL}" 
                                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}" />
                                            <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Accent.Blue.1}" />
                                            <TextBlock Text="{Binding CraftingBindings.Journal.PartialJournalPercent, Mode=OneWay, StringFormat={}{0:N2}%, FallbackValue=0.00%}" 
                                                       Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CraftingBindings.TranslationEmptyPrice, FallbackValue=EMPTY_PRICE}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                           MinWidth="80" VerticalAlignment="Center" />
                                <Grid MinWidth="120">
                                    <TextBox x:Name="EmptyJournalPriceTextBox" HorizontalAlignment="Left"
                                             Text="{Binding CraftingBindings.Journal.EmptyJournalPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="90" Height="28" Padding="8,2" common:TextBoxHelper.OnlyNumeric="Double" GotKeyboardFocus="JournalEmptyPrice_OnGotKeyboardFocus"
                                             PreviewMouseLeftButtonDown="PriceTextBox_OnPreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="JournalEmptyPrice_OnPreviewMouseLeftButtonUp" />
