                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ItemName}" Style="{StaticResource SavedCraftingCellText}" MaxHeight="42" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationTier}" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TierText}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tier}" Value="1">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.1}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="2">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.2}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="3">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.3}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="4">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.4}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="5">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.5}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="6">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.6}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="7">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.7}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier}" Value="8">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Tier.Color.8}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="." FontWeight="Bold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                                <TextBlock Text="{Binding EnchantmentLevelText}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="0">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Level.Color.0}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="1">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Level.Color.1}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="2">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Level.Color.2}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="3">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Level.Color.3}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EnchantmentLevel}" Value="4">
                                                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Item.Level.Color.4}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:BlackMarketBindings.TranslationQuality}" Width="120" DisplayMemberBinding="{Binding QualityName}" />
                                <GridViewColumn Header="{x:Static crafting:BlackMarketBindings.TranslationCurrentBuyPrice}" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrentBuyPrice, StringFormat={}{0:N0}}" Style="{StaticResource SavedCraftingCellText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:BlackMarketBindings.TranslationAverageBoughtPrice}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LatestAveragePrice, StringFormat={}{0:N0}}" Style="{StaticResource SavedCraftingCellText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:BlackMarketBindings.TranslationBoughtLast30Days}" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SoldLast30Days, StringFormat={}{0:N0}}" Style="{StaticResource SavedCraftingCellText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:BlackMarketBindings.TranslationBoughtLast365Days}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SoldLast365Days, StringFormat={}{0:N0}}" Style="{StaticResource SavedCraftingCellText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationChanged}" Width="135" DisplayMemberBinding="{Binding LastUpdatedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <GridSplitter Grid.Row="1"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource SolidColorBrush.Accent.Blue.4}" />

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0">
                            <TextBlock Text="{x:Static crafting:BlackMarketBindings.TranslationChartRange}"
                                       Foreground="{StaticResource SolidColorBrush.Text.2}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding ChartDayFilters}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedChartDays, Mode=TwoWay}"
                                      MinWidth="96"
                                      Height="24" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding SelectedItemTitle, FallbackValue=BLACK_MARKET}"
                                       Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{x:Static crafting:BlackMarketBindings.TranslationCurrentBuyPrice}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text="{Binding SelectedItem.CurrentBuyPrice, StringFormat={}{0:N0}, FallbackValue=0}" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static crafting:BlackMarketBindings.TranslationAverageBoughtPrice}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text="{Binding SelectedItem.LatestAveragePrice, StringFormat={}{0:N0}, FallbackValue=0}" Foreground="{StaticResource SolidColorBrush.Text.1}" Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static crafting:BlackMarketBindings.TranslationAverageItemsPerDay}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text="{Binding SelectedItemAverageItemsPerDayText, FallbackValue=0}" Foreground="{StaticResource SolidColorBrush.Text.1}" Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static crafting:BlackMarketBindings.TranslationBoughtLast30Days}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text="{Binding SelectedItem.SoldLast30Days, StringFormat={}{0:N0}, FallbackValue=0}" Foreground="{StaticResource SolidColorBrush.Text.1}" Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static crafting:BlackMarketBindings.TranslationBoughtLast365Days}" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text=": " Foreground="{StaticResource SolidColorBrush.Text.2}" />
                                <TextBlock Text="{Binding SelectedItem.SoldLast365Days, StringFormat={}{0:N0}, FallbackValue=0}" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <wpf:CartesianChart Grid.Row="1"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding ChartXAxes}"
                                        YAxes="{Binding ChartYAxes}"
                                        TooltipPosition="Center"
                                        FindingStrategy="ExactMatchTakeClosest"
                                        LegendPosition="Top"
                                        Background="Transparent"
                                        DrawMarginFrame="{x:Null}" />
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{x:Static crafting:CraftingOptimizerBindings.TranslationOptimizer}">
            <Grid DataContext="{Binding CraftingBindings.Optimizer}" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="{x:Static crafting:CraftingOptimizerBindings.TranslationTier}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding ItemTiers}" SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding SelectedTier, Mode=TwoWay}" Width="150" Margin="0,0,15,0" />
                    <ComboBox ItemsSource="{Binding MarketLocations}" SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding SelectedMarketLocation, Mode=TwoWay}" Width="180" Margin="0,0,15,0" />
                    <Button Content="{x:Static crafting:CraftingOptimizerBindings.TranslationScan}" Click="OptimizerScan_Click"
                            MinWidth="100" Margin="0,0,5,0" />
                    <Button Content="{x:Static crafting:CraftingOptimizerBindings.TranslationCancel}" Click="OptimizerCancel_Click"
                            IsEnabled="{Binding IsScanning}" Style="{StaticResource Style.Button.Danger}" MinWidth="100" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" Margin="0,8,0,8" />

                <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListView Grid.Row="3" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static crafting:CraftingBindings.TranslationIcon}" Width="45">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="32" Height="32" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="280" DisplayMemberBinding="{Binding ItemName}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="ItemName" Content="{x:Static crafting:CraftingBindings.TranslationItem}" Click="OptimizerResultsColumnHeader_Click" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="100" DisplayMemberBinding="{Binding RoiPercent, StringFormat={}{0:N1}%}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="RoiPercent" Content="{x:Static crafting:CraftingOptimizerBindings.TranslationRoi}" Click="OptimizerResultsColumnHeader_Click" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="130" DisplayMemberBinding="{Binding ProfitPerItem, StringFormat={}{0:N0}}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="ProfitPerItem" Content="{x:Static crafting:CraftingOptimizerBindings.TranslationProfitPerItem}" Click="OptimizerResultsColumnHeader_Click" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="130" DisplayMemberBinding="{Binding BreakEvenPrice, StringFormat={}{0:N0}}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="BreakEvenPrice" Content="{x:Static crafting:CraftingOptimizerBindings.TranslationBreakEvenPrice}" Click="OptimizerResultsColumnHeader_Click" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <TabItem Header="{x:Static crafting:RefiningBindings.TranslationRefining}">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="{x:Static crafting:RefiningBindings.TranslationRefining}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ================= Toolbar: search + filters ================= -->
                        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="14,10" Margin="0,0,0,14" Panel.ZIndex="20">
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBox x:Name="RefiningItemSearchTextBox" Text="{Binding RefiningBindings.ItemSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="RefiningItemSearch_OnGotKeyboardFocus"
                                             LostKeyboardFocus="RefiningItemSearch_OnLostKeyboardFocus"
                                             PreviewMouseLeftButtonUp="RefiningItemSearch_OnPreviewMouseLeftButtonUp"
                                             Width="280" TextWrapping="NoWrap" />
                                    <Grid Width="34" Height="34" Margin="4,0,0,0" ToolTip="{Binding RefiningBindings.NewCommand}">
                                        <fa5:ImageAwesome Icon="Solid_Redo" Width="14" Height="14" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Cursor="Hand" MouseUp="RefiningItemFilterReset_MouseUp" />
                                    </Grid>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding RefiningBindings.ResourceTypeOptions}"
                                          SelectedItem="{Binding RefiningBindings.SelectedResourceType, Mode=TwoWay}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName" Width="160" Margin="0,0,8,0"
                                          ToolTip="{x:Static crafting:RefiningBindings.TranslationResourceType}" />
                                <ComboBox ItemsSource="{Binding RefiningBindings.ItemTiers}"
                                          SelectedValue="{Binding RefiningBindings.SelectedItemTier, Mode=TwoWay}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value" MinWidth="64" Margin="0,0,8,0"
                                          ToolTip="{Binding RefiningBindings.TranslationTier}" />
                                <ComboBox ItemsSource="{Binding RefiningBindings.ItemLevels}"
                                          SelectedValue="{Binding RefiningBindings.SelectedItemLevel, Mode=TwoWay}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value" MinWidth="64"
                                          ToolTip="{x:Static crafting:CraftingBindings.TranslationItemEnchantment}" />

                                <Popup PlacementTarget="{Binding ElementName=RefiningItemSearchTextBox}" Placement="Bottom"
                                           IsOpen="{Binding RefiningBindings.IsItemSearchPopupOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                        <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                Style="{StaticResource Style.Card}" Padding="4" Width="420" MaxHeight="520">
                                            <ListBox x:Name="RefiningItemSearchListBox"
                                                     SelectionMode="Single"
                                                     SelectionChanged="ListBoxRefiningItemSearch_OnSelectionChanged"
                                                     PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                                     ItemsSource="{Binding RefiningBindings.ListBoxItemSearchItems}"
                                                     Width="420" MinHeight="38" MaxHeight="520"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,6">
                                                            <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Width="366" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                            </WrapPanel>
                        </Border>

                        <!-- ================= 3-column workspace: item/config | resources | results ================= -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" MinWidth="420" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: item identity + refining configuration -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                                    <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                        <Grid>
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationSelectItemToStart}"
                                                       Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                                       Visibility="{Binding RefiningBindings.SelectedItemEmptyVisibility}" />
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                                        Visibility="{Binding RefiningBindings.SelectedItemHeaderVisibility}">
                                                <Image Source="{Binding RefiningBindings.SelectedItem.Icon}" Width="96" Height="96" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding RefiningBindings.SelectedItem.LocalizedName}"
                                                           Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="17" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding RefiningBindings.SelectedItem.TierLevelString}"
                                                           Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Style="{StaticResource CraftingProfitabilityBadge}">
                                                    <Grid>
                                                        <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationProfitable}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingProfitabilityBadgeText}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RefiningBindings.Calculation.IsProfitPositive}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationNotProfitable}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingProfitabilityBadgeText}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RefiningBindings.Calculation.IsProfitNegative}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="—">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CraftingProfitabilityBadgeText}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding RefiningBindings.Calculation.IsProfitPositive}" Value="False" />
                                                                                <Condition Binding="{Binding RefiningBindings.Calculation.IsProfitNegative}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Style.Card}" Padding="18">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationRefining}" Style="{StaticResource CraftingSectionTitle}" />
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationRefiningSettingsSection}" Style="{StaticResource CraftingSubsectionLabel}" Margin="0,-8,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationNumberOfRuns}" Style="{StaticResource CraftingEditorLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefiningBindings.RefiningRuns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Natural" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationDailyBonusRrr}" Style="{StaticResource CraftingEditorLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RefiningBindings.DailyBonusOptions}"
                                                  SelectedItem="{Binding RefiningBindings.SelectedDailyBonus, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" Width="100" HorizontalAlignment="Left" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationHideoutBonus}" Style="{StaticResource CraftingEditorLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RefiningBindings.HideoutBonusOptions}"
                                                  SelectedItem="{Binding RefiningBindings.SelectedHideoutBonus, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" Width="190" HorizontalAlignment="Left" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10" Panel.ZIndex="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationRefiningLocation}" Style="{StaticResource CraftingEditorLabel}" />
                                        <Grid Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBox x:Name="RefiningLocationSearchTextBox"
                                                     Text="{Binding RefiningBindings.RefiningLocationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="190" TextWrapping="NoWrap"
                                                     GotKeyboardFocus="RefiningLocationSearch_OnGotKeyboardFocus" />
                                            <Popup PlacementTarget="{Binding ElementName=RefiningLocationSearchTextBox}"
                                                   Placement="Bottom"
                                                   IsOpen="{Binding RefiningBindings.IsRefiningLocationPopupOpen, Mode=TwoWay}"
                                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                                <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                        Style="{StaticResource Style.Card}" Padding="4" Width="320" MaxHeight="520">
                                                    <ListBox SelectionMode="Single"
                                                             SelectionChanged="ListBoxRefiningLocation_OnSelectionChanged"
                                                             PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                                             ItemsSource="{Binding RefiningBindings.ListBoxRefiningLocationItems}"
                                                             Width="320" MinHeight="38" MaxHeight="520"
                                                             BorderThickness="0" Background="Transparent"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Vertical" Margin="4,3">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource SolidColorBrush.Text.1}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding BonusSummary}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{Binding RefiningBindings.SelectedRefiningLocationBonusSummary}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationReturnRatePercent}" Style="{StaticResource CraftingEditorLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefiningBindings.ReturnRatePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                                    </Grid>

                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationPriceMarket}" Style="{StaticResource CraftingSubsectionLabel}" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationBuyMarketLocation}" Style="{StaticResource CraftingEditorLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RefiningBindings.MarketLocations}"
                                                  SelectedValue="{Binding RefiningBindings.SelectedBuyMarketLocation, Mode=TwoWay}"
                                                  SelectedValuePath="Key" DisplayMemberPath="Value" Width="190" HorizontalAlignment="Left" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationSellMarketLocation}" Style="{StaticResource CraftingEditorLabel}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RefiningBindings.MarketLocations}"
                                                  SelectedValue="{Binding RefiningBindings.SelectedSellMarketLocation, Mode=TwoWay}"
                                                  SelectedValuePath="Key" DisplayMemberPath="Value" Width="190" HorizontalAlignment="Left" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationStationFee}" Style="{StaticResource CraftingEditorLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefiningBindings.StationFee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationSalesTaxPercent}" Style="{StaticResource CraftingEditorLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefiningBindings.SalesTaxPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationSetupFee}" Style="{StaticResource CraftingEditorLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefiningBindings.SetupFeePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationOtherCosts}" Style="{StaticResource CraftingEditorLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefiningBindings.OtherCosts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" common:TextBoxHelper.OnlyNumeric="Double" />
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningBindings.TranslationSellPrice}" Style="{StaticResource CraftingEditorLabel}" />
                                        <Grid Grid.Column="1" HorizontalAlignment="Left">
                                            <TextBox x:Name="RefiningOutputUnitPriceTextBox"
                                                     Text="{Binding RefiningBindings.OutputUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="100" common:TextBoxHelper.OnlyNumeric="Double"
                                                     GotKeyboardFocus="RefiningOutputUnitPrice_OnGotKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="PriceTextBox_OnPreviewMouseLeftButtonDown"
                                                     PreviewMouseLeftButtonUp="RefiningOutputUnitPrice_OnPreviewMouseLeftButtonUp" />
                                            <Popup PlacementTarget="{Binding ElementName=RefiningOutputUnitPriceTextBox}"
                                                   Placement="Bottom"
                                                   IsOpen="{Binding RefiningBindings.IsSellPricePopupOpen, Mode=TwoWay}"
                                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                                <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                        Style="{StaticResource Style.Card}" Padding="4" Width="230" MaxHeight="360">
                                                    <ListBox SelectionMode="Single"
                                                             SelectionChanged="ListBoxRefiningSellPrice_OnSelectionChanged"
                                                             PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                                             ItemsSource="{Binding RefiningBindings.SellPriceOptions}"
                                                             Width="230" MinHeight="38" MaxHeight="360"
                                                             BorderThickness="0" Background="Transparent"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding UpdateDateTimeText}" Style="{StaticResource CraftingSellPriceOptionText}" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{x:Static crafting:CraftingBindings.TranslationNew}" MinWidth="72" Command="{Binding RefiningBindings.NewCommand}" />
                                        <Button Content="{x:Static crafting:CraftingBindings.TranslationPrices}" MinWidth="72" Margin="8,0,0,0" Command="{Binding RefiningBindings.LoadPricesCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding RefiningBindings.StatusText}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Column 2: resources, full available height -->
                            <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="18">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{x:Static crafting:RefiningBindings.TranslationResources}" Style="{StaticResource CraftingSectionTitle}" />

                                    <!-- Multi-city sourcing controls: global-city toggle, purchase optimizer, city-exclusion filter -->
                                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding RefiningBindings.UseGlobalCity, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationUseGlobalCity}" Style="{StaticResource CraftingEditorLabel}" Margin="8,0,20,0" />
                                            <Button Content="{x:Static crafting:RefiningBindings.TranslationOptimizePurchase}" MinWidth="130"
                                                    Command="{Binding RefiningBindings.OptimizePurchaseCommand}"
                                                    IsEnabled="{Binding RefiningBindings.IsNotOptimizingPurchase}" />
                                        </StackPanel>
                                        <WrapPanel Visibility="{Binding RefiningBindings.PerCitySourcingVisibility}" Margin="0,8,0,0">
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationExcludedCities}" Style="{StaticResource CraftingEditorLabel}" Margin="0,0,10,4" />
                                            <ItemsControl ItemsSource="{Binding RefiningBindings.SourcingCityFilters}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}" Content="{Binding DisplayName}"
                                                                  Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="0,0,14,4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding RefiningBindings.OptimizationSummaryText}" Foreground="{StaticResource SolidColorBrush.Accent.Green.2}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <ListView ItemsSource="{Binding RefiningBindings.Resources}" BorderThickness="0" Background="Transparent">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationIcon}" Width="45">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding Icon}" Width="32" Height="32" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationItem}" Width="250">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{StaticResource SolidColorBrush.Text.1}"
                                                                       Cursor="Hand" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       MouseLeftButtonUp="CopyTextBlockTextToClipboard_OnMouseLeftButtonUp" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationType}" Width="125" DisplayMemberBinding="{Binding ResourceKindText}" />
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationBuyCity}" Width="150">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.RefiningBindings.ResourceMarketLocations, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                      SelectedValue="{Binding SourceLocation, Mode=TwoWay}"
                                                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                                                      Width="135" Height="28"
                                                                      IsEnabled="{Binding DataContext.RefiningBindings.IsPerCitySourcingEnabled, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationGross}" Width="80">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding GrossQuantity, StringFormat={}{0:#,0.##}}" Style="{StaticResource CraftingResourceQuantityText}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationExpectedReturn}" Width="115">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ExpectedReturnQuantity, StringFormat={}{0:#,0.##}}" Style="{StaticResource CraftingResourceQuantityText}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationNet}" Width="80">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding NetQuantity, StringFormat={}{0:#,0.##}}" Style="{StaticResource CraftingResourceNetQuantityText}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationPrice}" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBox x:Name="RefiningResourceUnitPriceTextBox"
                                                                         Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="78" Height="28" Padding="8,2" common:TextBoxHelper.OnlyNumeric="Double"
                                                                         GotKeyboardFocus="RefiningResourcePrice_OnGotKeyboardFocus"
                                                                         PreviewMouseLeftButtonDown="PriceTextBox_OnPreviewMouseLeftButtonDown"
                                                                         PreviewMouseLeftButtonUp="RefiningResourcePrice_OnPreviewMouseLeftButtonUp" />
                                                                <Popup PlacementTarget="{Binding ElementName=RefiningResourceUnitPriceTextBox}"
                                                                       Placement="Bottom"
                                                                       IsOpen="{Binding IsPricePopupOpen, Mode=TwoWay}"
                                                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                                                    <Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                                            Style="{StaticResource Style.Card}" Padding="4" Width="230" MaxHeight="360">
                                                                        <ListBox SelectionMode="Single"
                                                                                 SelectionChanged="ListBoxRefiningResourcePrice_OnSelectionChanged"
                                                                                 PreviewMouseWheel="PopupListBox_OnPreviewMouseWheel"
                                                                                 ItemsSource="{Binding PriceOptions}"
                                                                                 Tag="{Binding}"
                                                                                 Width="230" MinHeight="38" MaxHeight="360"
                                                                                 BorderThickness="0" Background="Transparent"
                                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding UpdateDateTimeText}" Style="{StaticResource CraftingSellPriceOptionText}" />
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationNetCost}" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding NetCost, StringFormat={}{0:N0}}" Style="{StaticResource CraftingResourceCostText}" />
                                                                <Image Style="{StaticResource Icon.Silver}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </Border>

                            <!-- Column 3: results, headline first -->
                            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                                    <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationProfitabilitySection}" Style="{StaticResource CraftingSectionTitle}" />
                                            <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationProfit}" Style="{StaticResource CraftingHeadlineLabel}" />
                                            <TextBlock Text="{Binding RefiningBindings.Calculation.Profit, StringFormat={}{0:N0}, FallbackValue=0}"
                                                       Style="{StaticResource CraftingHeadlineProfitValue}" FontSize="34" />
                                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                                <Border Style="{StaticResource CraftingResultTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationRoi}" Style="{StaticResource CraftingResultLabel}" />
                                                        <TextBlock Text="{Binding RefiningBindings.Calculation.RoiPercent, StringFormat={}{0:N2}%, FallbackValue=0.00%}" Style="{StaticResource CraftingResultRoiValue}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource CraftingResultTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationProfitPerItem}" Style="{StaticResource CraftingResultLabel}" />
                                                        <TextBlock Text="{Binding RefiningBindings.Calculation.ProfitPerItem, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultProfitPerItemValue}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource CraftingResultTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationTotalCosts}" Style="{StaticResource CraftingResultLabel}" />
                                                        <TextBlock Text="{Binding RefiningBindings.Calculation.TotalCosts, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource CraftingResultTile}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationBreakEven}" Style="{StaticResource CraftingResultLabel}" />
                                                        <TextBlock Text="{Binding RefiningBindings.Calculation.BreakEvenPrice, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultBreakEvenValue}" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Style.Card}" Padding="18">
                                        <StackPanel Orientation="Vertical">
                                            <Expander IsExpanded="True" Foreground="{StaticResource SolidColorBrush.TextSecondary}">
                                                <Expander.Header>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationRevenue}" Style="{StaticResource CraftingSectionTitle}" Margin="0" />
                                                </Expander.Header>
                                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationRevenue}" Style="{StaticResource CraftingSubsectionLabel}" Margin="0,0,0,6" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationOutput}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.OutputQuantity, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultInfoValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationSalesGross}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.SalesRevenueGross, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultRevenueValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationSalesNet}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.SalesRevenueNet, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultRevenueValue}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        
                                                </StackPanel>
                                            </Expander>
                                            <Expander IsExpanded="False" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="0,8,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationCosts}" Style="{StaticResource CraftingSectionTitle}" Margin="0" />
                                                </Expander.Header>
                                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationCosts}" Style="{StaticResource CraftingSubsectionLabel}" Margin="0,10,0,6" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationTotalCosts}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.TotalCosts, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationGrossMaterials}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.GrossMaterialCosts, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationNetMaterials}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.NetMaterialCosts, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationNonReturnable}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.NonReturnableMaterialCosts, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationStation}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.StationFee, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationOtherCosts}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.OtherCosts, StringFormat={}{0:N0}, FallbackValue=0}" Style="{StaticResource CraftingResultCostValue}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        
                                                </StackPanel>
                                            </Expander>
                                            <Expander IsExpanded="False" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="0,8,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationWeightSection}" Style="{StaticResource CraftingSectionTitle}" Margin="0" />
                                                </Expander.Header>
                                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationWeightSection}" Style="{StaticResource CraftingSubsectionLabel}" Margin="0,10,0,6" />
                                        <WrapPanel>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationWeightBefore}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.WeightBeforeCrafting, StringFormat={}{0:N2}, FallbackValue=0.00}" Style="{StaticResource CraftingResultValue}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CraftingResultTile}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static crafting:RefiningBindings.TranslationWeightAfter}" Style="{StaticResource CraftingResultLabel}" />
                                                    <TextBlock Text="{Binding RefiningBindings.Calculation.WeightAfterCrafting, StringFormat={}{0:N2}, FallbackValue=0.00}" Style="{StaticResource CraftingResultValue}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{x:Static crafting:RefiningOptimizerBindings.TranslationOptimizer}">
                    <Grid DataContext="{Binding RefiningBindings.Optimizer}" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="{x:Static crafting:RefiningOptimizerBindings.TranslationTier}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox ItemsSource="{Binding ItemTiers}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding SelectedTier, Mode=TwoWay}" Width="150" Margin="0,0,15,0" />
                            <ComboBox ItemsSource="{Binding MarketLocations}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding SelectedMarketLocation, Mode=TwoWay}" Width="180" Margin="0,0,15,0" />
                            <Button Content="{x:Static crafting:RefiningOptimizerBindings.TranslationScan}" Click="RefiningOptimizerScan_Click"
                                    MinWidth="100" Margin="0,0,5,0" />
                            <Button Content="{x:Static crafting:RefiningOptimizerBindings.TranslationCancel}" Click="RefiningOptimizerCancel_Click"
                                    IsEnabled="{Binding IsScanning}" Style="{StaticResource Style.Button.Danger}" MinWidth="100" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" Margin="0,8,0,8" />

                        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ListView Grid.Row="3" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationIcon}" Width="45">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="32" Height="32" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static crafting:RefiningBindings.TranslationItem}" Width="220" DisplayMemberBinding="{Binding ItemName}" />
                                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding OutputUnitPrice, StringFormat={}{0:N0}}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="OutputUnitPrice" Content="{x:Static crafting:RefiningBindings.TranslationSellPrice}" Click="RefiningOptimizerResultsColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding RoiPercent, StringFormat={}{0:N2}%}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="RoiPercent" Content="{x:Static crafting:RefiningOptimizerBindings.TranslationRoi}" Click="RefiningOptimizerResultsColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding ProfitPerItem, StringFormat={}{0:N0}}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="ProfitPerItem" Content="{x:Static crafting:RefiningOptimizerBindings.TranslationProfitPerItem}" Click="RefiningOptimizerResultsColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding BreakEvenPrice, StringFormat={}{0:N0}}">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Tag="BreakEvenPrice" Content="{x:Static crafting:RefiningOptimizerBindings.TranslationBreakEvenPrice}" Click="RefiningOptimizerResultsColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>
