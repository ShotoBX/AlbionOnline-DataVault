<UserControl x:Class="StatisticsAnalysisTool.UserControls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:models="clr-namespace:StatisticsAnalysisTool.Models"
             xmlns:crafting="clr-namespace:StatisticsAnalysisTool.Crafting"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <UserControl.Resources>
        <Style x:Key="Kpi.Card" TargetType="Border" BasedOn="{StaticResource Style.Card}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <Style x:Key="Kpi.Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Kpi.Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Kpi.Icon" TargetType="fa5:ImageAwesome">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Kpi.ClusterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.4}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,0,0,8" />
        </Style>
        <Style x:Key="Section.Header" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Panel}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,4,10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top-3 recommendation row, shared by the Crafting and Refining recommendation cards -->
        <DataTemplate x:Key="Dashboard.OptimizerTopResultTemplate" DataType="{x:Type crafting:CraftingOptimizerResult}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding ItemName}" Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding RoiPercent, StringFormat={}{0:N1}% ROI}" Foreground="{StaticResource SolidColorBrush.Accent.Green.3}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource TabItemGridStyle}">
        <ScrollViewer>
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Vertical" Margin="10,14,10,0">
                    <TextBlock Text="{Binding DashboardBindings.TranslationCombat, FallbackValue='COMBAT'}" Style="{StaticResource Kpi.ClusterLabel}" />
                    <WrapPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_Eye" Style="{StaticResource Kpi.Icon}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationPlayersTracked, FallbackValue='PLAYERS_TRACKED'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DashboardBindings.PlayersTracked, FallbackValue=0}" Style="{StaticResource Kpi.Value}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_FistRaised" Style="{StaticResource Kpi.Icon}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationFightCount, FallbackValue='FIGHT_COUNT'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DamageMeterBindings.CurrentYourStats.FightCount, FallbackValue=0}" Style="{StaticResource Kpi.Value}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_Bolt" Style="{StaticResource Kpi.Icon}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationYourDps, FallbackValue='YOUR_DPS'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DamageMeterBindings.CurrentYourStats.TotalDps, FallbackValue=0}" Style="{StaticResource Kpi.Value}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_Heartbeat" Style="{StaticResource Kpi.Icon}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationYourHealing, FallbackValue='YOUR_HEALING'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DamageMeterBindings.CurrentYourStats.TotalHealing, FallbackValue=0}" Style="{StaticResource Kpi.Value}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_SkullCrossbones" Style="{StaticResource Kpi.Icon}" Foreground="{StaticResource SolidColorBrush.Error}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationDeaths, FallbackValue='DEATHS'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DashboardBindings.DeathsToday, FallbackValue=0}" Style="{StaticResource Kpi.Value}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding DashboardBindings.TranslationEconomy, FallbackValue='ECONOMY'}" Style="{StaticResource Kpi.ClusterLabel}" />
                    <WrapPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="../Resources/silver.png" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationSilver, FallbackValue='SILVER'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DashboardBindings.EconomySilverToday, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Kpi.Value}" Foreground="{StaticResource SolidColorBrush.Accent}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="../Resources/fame.png" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationFame, FallbackValue='FAME'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DashboardBindings.EconomyFameToday, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" Style="{StaticResource Kpi.Value}" Foreground="{StaticResource SolidColorBrush.Warning}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding DashboardBindings.TranslationSession, FallbackValue='SESSION'}" Style="{StaticResource Kpi.ClusterLabel}" />
                    <WrapPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_MapMarkerAlt" Style="{StaticResource Kpi.Icon}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationCurrentMap, FallbackValue='CURRENT_MAP'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UserTrackingBindings.CurrentMapInfoBinding.DisplayedClusterName, FallbackValue=-}" Style="{StaticResource Kpi.Value}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kpi.Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa5:ImageAwesome Icon="Solid_Users" Style="{StaticResource Kpi.Icon}" />
                                    <TextBlock Text="{Binding DashboardBindings.TranslationPartyMembers, FallbackValue='PARTY_MEMBERS'}" Style="{StaticResource Kpi.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PartyMemberNumber, FallbackValue=0}" Style="{StaticResource Kpi.Value}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <Border Style="{StaticResource Style.Card}" Margin="10,0,10,10" Padding="4">
                <Grid>
                    <DockPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                        <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                            <Image Source="../Resources/fame.png" Width="22" Height="22" ToolTip="{Binding Translation.Fame, FallbackValue=FAME}" />
                            <TextBlock Text="{Binding DashboardBindings.TotalGainedFameInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="16" Text="{Binding DashboardBindings.FamePerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                            <Image Source="../Resources/silver.png" Width="22" Height="22" ToolTip="{Binding Translation.Silver, FallbackValue=SILVER}" />
                            <TextBlock Text="{Binding DashboardBindings.TotalGainedSilverInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="16" Text="{Binding DashboardBindings.SilverPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                            <Image Source="../Resources/respec.png" Width="22" Height="22" ToolTip="{Binding Translation.ReSpec, FallbackValue=RESPEC}" />
                            <TextBlock Text="{Binding DashboardBindings.TotalGainedReSpecPointsInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="16" Text="{Binding DashboardBindings.ReSpecPointsPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                            <Image Source="../Resources/might.png" Width="22" Height="22" ToolTip="{Binding Translation.Might, FallbackValue=MIGHT}" />
                            <TextBlock Text="{Binding DashboardBindings.TotalGainedMightInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="16" Text="{Binding DashboardBindings.MightPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="10,0,10,0">
                            <Image Source="../Resources/favor.png" Width="22" Height="22" ToolTip="{Binding Translation.Favor, FallbackValue=FAVOR}" />
                            <TextBlock Text="{Binding DashboardBindings.TotalGainedFavorInSession, Converter={StaticResource ShortNumberConverter}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}, FallbackValue=0}" 
                                       FontSize="16" Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                            <TextBlock FontSize="16" Text="{Binding DashboardBindings.FavorPerHour, Converter={StaticResource ValuePerHourConverter}, FallbackValue=0 /h}"
                           Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FactionPointStats}" ItemTemplate="{StaticResource FactionPointStatsTemplate}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,5,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel IsEnabled="{Binding IsTrackingActive, FallbackValue=false}" Width="240">
                            <Grid>
                                <DockPanel Width="auto" HorizontalAlignment="Right">
                                    <Button Content="{Binding Translation.ResetTrackingCounter, FallbackValue=RESET__TRACKING__COUNTER}" 
                                            Width="237" Height="26" Click="BtnTrackingReset_Click" />
                                </DockPanel>
                            </Grid>
                            <CheckBox IsChecked="{Binding IsTrackingResetByMapChangeActive}" Content="{Binding Translation.MapChangeReset, FallbackValue=MAP__CHANGE__RESET}"/>
                        </StackPanel>
                        <Grid Height="20" Width="20" Margin="5,3,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                              ToolTip="{Binding Translation.OpenExtendedDashboardWindow, FallbackValue=OPEN__EXTENDED__DAMAGE__METER__WINDOW}" MouseUp="OpenDashboardWindow_MouseUp">
                            <fa5:ImageAwesome Icon="Solid_Expand" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </Grid>
                    </StackPanel>
                </Grid>
                </Border>
                <!-- Kill / Death stats -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="KillDeathToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.KillDeathStatsToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.KillsDeathsText, FallbackValue='KILL_DEATHS'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ContentControl Visibility="{Binding DashboardBindings.KillDeathStatsVisibility}" Margin="3" 
                                Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource KillDeathStatsTemplate}" />

                <!-- Looted Chests -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="LootedChestsToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.LootedChestsStatsToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.TranslationLootedChests, FallbackValue='LOOTED_CHESTS'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ContentControl Visibility="{Binding DashboardBindings.LootedChestsStatsVisibility}" Margin="3" 
                                Content="{Binding DashboardBindings.LootedChests}" ContentTemplate="{StaticResource LootedChestsTemplate}" />

                <!-- ReSpec -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="ReSpecStatsToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.ReSpecStatsToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.TranslationReSpec, FallbackValue='RESPEC'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ContentControl Visibility="{Binding DashboardBindings.ReSpecStatsVisibility}" Margin="3"  
                                Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource SilverCostForReSpecTemplate}" />

                <!-- Repair costs -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="RepairCostsStatsToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.RepairCostsStatsToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.TranslationRepairCosts, FallbackValue='REPAIR_COSTS'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ContentControl Visibility="{Binding DashboardBindings.RepairCostsStatsVisibility}" Margin="3"
                                Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource RepairCostsTemplate}" />

                <!-- Economy -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="EconomyStatsToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.EconomyStatsToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.TranslationEconomy, FallbackValue='ECONOMY'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ContentControl Visibility="{Binding DashboardBindings.EconomyStatsVisibility}" Margin="3"
                                Content="{Binding DashboardBindings}" ContentTemplate="{StaticResource EconomyStatsTemplate}" />

                <!-- Crafting / Refining recommendation -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="CraftingRecommendationToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.CraftingRecommendationToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.TranslationCraftingRecommendation, FallbackValue='CRAFTING_RECOMMENDATION'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid Visibility="{Binding DashboardBindings.CraftingRecommendationVisibility}" Margin="10,6,10,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Style.Card}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static crafting:CraftingOptimizerBindings.TranslationOptimizer}" FontWeight="SemiBold"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{x:Static crafting:CraftingOptimizerBindings.TranslationScan}"
                                        Height="26" MinWidth="80" Margin="0,0,5,0" Click="DashboardCraftingRecommendationScan_Click" />
                                <Button Grid.Column="2" Content="{x:Static crafting:CraftingOptimizerBindings.TranslationCancel}"
                                        Height="26" MinWidth="80" IsEnabled="{Binding CraftingBindings.Optimizer.IsScanning}"
                                        Style="{StaticResource Style.Button.Danger}" Click="DashboardCraftingRecommendationCancel_Click" />
                            </Grid>
                            <TextBlock Text="{Binding CraftingBindings.Optimizer.StatusText}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                         Visibility="{Binding CraftingBindings.Optimizer.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Height="104" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding CraftingBindings.Optimizer.Results}" ItemTemplate="{StaticResource Dashboard.OptimizerTopResultTemplate}" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Style.Card}" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static crafting:RefiningOptimizerBindings.TranslationOptimizer}" FontWeight="SemiBold"
                                           Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{x:Static crafting:RefiningOptimizerBindings.TranslationScan}"
                                        Height="26" MinWidth="80" Margin="0,0,5,0" Click="DashboardRefiningRecommendationScan_Click" />
                                <Button Grid.Column="2" Content="{x:Static crafting:RefiningOptimizerBindings.TranslationCancel}"
                                        Height="26" MinWidth="80" IsEnabled="{Binding RefiningBindings.Optimizer.IsScanning}"
                                        Style="{StaticResource Style.Button.Danger}" Click="DashboardRefiningRecommendationCancel_Click" />
                            </Grid>
                            <TextBlock Text="{Binding RefiningBindings.Optimizer.StatusText}" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                         Visibility="{Binding RefiningBindings.Optimizer.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Height="104" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding RefiningBindings.Optimizer.Results}" ItemTemplate="{StaticResource Dashboard.OptimizerTopResultTemplate}" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activity chart -->
                <Border Style="{StaticResource Section.Header}" MouseLeftButtonDown="ActivityChartToggle_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Height="34">
                        <fa5:ImageAwesome Icon="{Binding DashboardBindings.ActivityChartToggleIcon, FallbackValue='Solid_Minus'}"
                                          Foreground="{StaticResource SolidColorBrush.Text.1}" Height="14" Width="14" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue='HISTORY'}"
                                   FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid Visibility="{Binding DashboardBindings.ActivityChartVisibility}" Margin="10,6,10,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="300" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding DashboardBindings.TranslationActivityChart, FallbackValue='HISTORY'}"
                                   Foreground="{StaticResource SolidColorBrush.Text.1}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="180"
                                  MinHeight="32"
                                  ItemsSource="{Binding DashboardChartRanges}"
                                  SelectedItem="{Binding SelectedDashboardChartRange, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="DashboardChartRange_SelectionChanged" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding DashboardChartSeriesFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DashboardChartSeriesFilter}">
                                <Border BorderBrush="{StaticResource SolidColorBrush.Hover}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Margin="0,0,8,8"
                                        Padding="10,5"
                                        Background="{StaticResource SolidColorBrush.Card}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Checked="DashboardChartSeriesVisibility_Changed"
                                                  Unchecked="DashboardChartSeriesVisibility_Changed"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Style="{StaticResource Style.Card}" Padding="10">
                        <wpf:CartesianChart Series="{Binding SeriesDashboardHourValues}"
                                            XAxes="{Binding XAxesDashboardHourValues}"
                                            YAxes="{Binding YAxesDashboardHourValues}"
                                            TooltipPosition="Center"
                                            FindingStrategy="ExactMatchTakeClosest"
                                            LegendPosition="Hidden"
                                            Background="Transparent"
                                            AnimationsSpeed="0:0:0.4"
                                            DrawMarginFrame="{x:Null}" />
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
