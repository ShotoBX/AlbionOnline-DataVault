<UserControl x:Class="StatisticsAnalysisTool.UserControls.FooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vm="clr-namespace:StatisticsAnalysisTool.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FooterViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="46" d:DesignWidth="1100">

    <Grid ZIndex="1" Background="{StaticResource SolidColorBrush.Panel}">
        <Border VerticalAlignment="Top" Height="1" Background="{StaticResource SolidColorBrush.Hover}" />

        <!-- Live status strip: connection state + username/guild/alliance/map, moved here from the header -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsInGame}" Margin="0,0,10,0">
                <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                <TextBlock Text="{Binding MainStatusBindings.InGameStatusText, FallbackValue=LOGGED__OUT}" Style="{StaticResource MainHeaderStatus.Text}" />
            </StackPanel>
            <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsServerDetected}" Margin="0,0,10,0">
                <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                <TextBlock Text="{Binding MainStatusBindings.ServerStatusText, FallbackValue=SERVER__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
            </StackPanel>
            <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsCharacterDetected}" Margin="0,0,10,0">
                <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                <TextBlock Text="{Binding MainStatusBindings.CharacterStatusText, FallbackValue=CHARACTER__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
            </StackPanel>
            <StackPanel Style="{StaticResource MainHeaderStatus.Row}" Tag="{Binding MainStatusBindings.IsLocationDetected}" Margin="0,0,16,0">
                <Ellipse Style="{StaticResource MainHeaderStatus.Dot}" />
                <TextBlock Text="{Binding MainStatusBindings.LocationStatusText, FallbackValue=LOCATION__UNDETECTED}" Style="{StaticResource MainHeaderStatus.Text}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.UsernameInformationVisibility, FallbackValue=Hidden}">
                <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.Username, FallbackValue=USERNAME}" ContentStringFormat="{}{0}: " FontSize="11" />
                <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.Username, FallbackValue=USERNAME}" FontSize="11" />
                <Grid Visibility="{Binding TrackingActivityBindings.CharacterIsNotTrackedInfoVisibility, FallbackValue=Collapsed}" Height="16" Width="16" Margin="4,0,0,0" VerticalAlignment="Center"
                      ToolTip="{Binding Translation.ThisCharacterIsNotTracked, FallbackValue=THIS_CHARACTER_IS_NOT_TRACKED}">
                    <fa5:ImageAwesome Icon="Solid_ExclamationTriangle" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.1}" />
                </Grid>
                <Label Content=" | " FontSize="11" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.GuildInformationVisibility, FallbackValue=Collapsed}">
                <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.GuildCap, FallbackValue=GUILD}" ContentStringFormat="{}{0}: " FontSize="11" />
                <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.GuildName, FallbackValue=GUILD__NAME}" FontSize="11" />
                <Label Content=" | " FontSize="11" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.AllianceInformationVisibility, FallbackValue=Collapsed}">
                <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.Alliance, FallbackValue=ALLIANCE}" ContentStringFormat="{}{0}: " FontSize="11" />
                <Label Style="{StaticResource HeaderStyle.Tracking.Content}" Content="{Binding UserTrackingBindings.AllianceName, FallbackValue=ALLIANCE__NAME}" FontSize="11" />
                <Label Content=" | " FontSize="11" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding UserTrackingBindings.CurrentMapInfoBinding.CurrentMapInformationVisibility, FallbackValue=Collapsed}">
                <Label Style="{StaticResource HeaderStyle.Tracking.Title}" Content="{Binding Translation.CurrentMap, FallbackValue=CURRENT__MAP}" ContentStringFormat="{}{0}: " FontSize="11" />
                <ContentControl Content="{Binding UserTrackingBindings.CurrentMapInfoBinding}" ContentTemplate="{StaticResource CurrentMapInfoTemplate}" />
            </StackPanel>
        </StackPanel>

        <!-- Branding: version + credit + social links -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
            <Label x:Name="VersionLabel" Content="{Binding Version, FallbackValue=VERSION}"
                   FontSize="12" Padding="0" Margin="0,0,10,0" VerticalContentAlignment="Center" MouseLeftButtonDown="VersionLabel_MouseLeftButtonDown">
                <Label.Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="{StaticResource Color.Accent.Blue.4}" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="UpdateAvailableBlinkStoryboard">
                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Label.Foreground).(SolidColorBrush.Color)"
                                                            To="{StaticResource Color.Accent.Red.2}" Duration="0:0:0.55" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="UpdateAvailableBlinkStoryboard" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
            <Label Content="Made by Triky313" Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" Padding="0" Margin="0,0,14,0" VerticalContentAlignment="Center" />

            <Grid ZIndex="10" Margin="5,0" Width="18" Height="18" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink NavigateUri="{Binding GitHubRepoUrl}" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}">
                        <fa5:ImageAwesome Icon="Brands_Github" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
            <Grid ZIndex="10" Margin="5,0" Width="18" Height="18" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink NavigateUri="{Binding DiscordUrl}" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}">
                        <fa5:ImageAwesome Icon="Brands_Discord" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
            <Grid ZIndex="10" Margin="5,0" Width="18" Height="18" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink NavigateUri="{Binding DonateUrl}" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}">
                        <fa5:ImageAwesome Icon="Brands_Paypal" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
            <Grid ZIndex="10" Margin="5,0" Width="18" Height="18" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink NavigateUri="{Binding PatreonUrl}" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}">
                        <fa5:ImageAwesome Icon="Brands_Patreon" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
