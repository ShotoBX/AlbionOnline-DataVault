<UserControl x:Class="StatisticsAnalysisTool.UserControls.GatheringControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:gathering="clr-namespace:StatisticsAnalysisTool.Gathering"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="170" MinHeight="34" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemsSource="{Binding GatheringBindings.GatheringStatsTimeTypes}"
                              SelectedValue="{Binding GatheringBindings.GatheringStatsTimeTypeSelection}"
                              IsSynchronizedWithCurrentItem="True" DisplayMemberPath="Name" SelectedValuePath="GatheringStatsTimeType" />

                    <CheckBox IsChecked="{Binding GatheringBindings.IsGatheringActive, FallbackValue=true}"
                              Content="{Binding GatheringBindings.TranslationGatheringActive, FallbackValue=GATHERING__ACTIVE}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,20,0" />

                    <ComboBox Width="200" MinHeight="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemsSource="{Binding GatheringBindings.AutoDeleteStatsByDate}"
                              SelectedValue="{Binding GatheringBindings.AutoDeleteStatsByDateSelection}"
                              IsSynchronizedWithCurrentItem="True" DisplayMemberPath="Name" SelectedValuePath="AutoDeleteGatheringStats" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding Translation.SelectDeselectAll, FallbackValue=SELECT__DESELECT__ALL}" Margin="0,0,8,0"
                            MinWidth="180" Click="BtnSelectSwitchAllGathered_Click" />
                    <Button Content="{Binding Translation.DeleteSelectedResources, FallbackValue=DELETE__SELECTED__RESOURCES}"
                            Style="{StaticResource Style.Button.Danger}" MinWidth="180" Click="BtnDeleteSelectedGathered_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="{Binding GatheringBindings.GridSplitterPosition ,Mode=TwoWay, FallbackValue=*}"/>
            </Grid.RowDefinitions>

            <!-- Resource category tabs: replaces the old dropdown that silently swapped the whole
                 view below - a real tab strip is far more discoverable. Same GatheringFilter /
                 SelectedGatheringFilter binding that already drove the dropdown; the tab strip only
                 selects, the existing DataTrigger-driven panels below still render the content. -->
            <TabControl Grid.Row="0" Margin="0,0,0,10" Background="Transparent" BorderThickness="0"
                        ItemsSource="{Binding GatheringBindings.GatheringFilter}"
                        SelectedValue="{Binding GatheringBindings.SelectedGatheringFilter, Mode=TwoWay}"
                        SelectedValuePath="Key" DisplayMemberPath="Value">
                <TabControl.ContentTemplate>
                    <DataTemplate />
                </TabControl.ContentTemplate>
            </TabControl>

            <GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Margin="0,0,1,1" Background="{StaticResource SolidColorBrush.Hover}" />

            <Grid Grid.Row="1" Grid.RowSpan="2">
                <ScrollViewer>
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Generally}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,10">
                                <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource GenerallyTemplate}" />
                            </Border>
                            <Border Style="{StaticResource Style.Card}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="300" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Style="{StaticResource Gathering.Stats.TitleText}"
                                               Text="{x:Static gathering:GatheringStats.TranslationHistory}"
                                               Margin="0" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <ComboBox Width="250"
                                                  MinHeight="34"
                                                  ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceChartValueTypes}"
                                                  SelectedValue="{Binding GatheringBindings.GatheringStats.SelectedResourceChartValueType, Mode=TwoWay}"
                                                  SelectedValuePath="GatheringChartValueType"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <ItemsControl Grid.Row="2"
                                                  Margin="0,10,0,10"
                                                  ItemsSource="{Binding GatheringBindings.GatheringStats.ResourceChartSeriesFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type gathering:GatheringChartSeriesFilter}">
                                                <Border Style="{StaticResource Style.Card}"
                                                        Margin="0,0,8,8"
                                                        Padding="10,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <wpf:CartesianChart Grid.Row="3"
                                                        Series="{Binding GatheringBindings.GatheringStats.ResourceChartSeries}"
                                                        XAxes="{Binding GatheringBindings.GatheringStats.ResourceChartXAxes}"
                                                        TooltipPosition="Center"
                                                        FindingStrategy="ExactMatchTakeClosest"
                                                        LegendPosition="Hidden"
                                                        Background="Transparent"
                                                        DrawMarginFrame="{x:Null}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Wood}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource WoodTemplate}" />
                        </Border>
                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Fiber}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource FiberTemplate}" />
                        </Border>
                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Ore}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource OreTemplate}" />
                        </Border>
                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Hide}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource HideTemplate}" />
                        </Border>
                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Rock}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource RockTemplate}" />
                        </Border>
                        <Border Padding="18">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Card}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GatheringBindings.SelectedGatheringFilter}" Value="{x:Static gathering:GatheringFilterType.Fishing}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl Content="{Binding GatheringBindings.GatheringStats}" ContentTemplate="{StaticResource FishingTemplate}" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <controls:VirtualizingItemsControl ItemsSource="{Binding GatheringBindings.GatheredCollectionView, IsAsync=True, Mode=OneWay}"
                                                   ItemTemplate="{StaticResource GatheredItemTemplate}"
                                                   VirtualizingPanel.CacheLengthUnit="Item"
                                                   VirtualizingPanel.CacheLength="10,10"
                                                   VirtualizingPanel.ScrollUnit="Pixel"
                                                   VirtualizingPanel.VirtualizationMode="Recycling"
                                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                   ScrollViewer.VerticalScrollBarVisibility="Visible" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
