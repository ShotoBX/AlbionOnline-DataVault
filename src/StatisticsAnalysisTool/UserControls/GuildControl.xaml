<UserControl x:Class="StatisticsAnalysisTool.UserControls.GuildControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:damageMeter="clr-namespace:StatisticsAnalysisTool.DamageMeter"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <Grid>
        <TabControl SelectedIndex="0" Background="Transparent">
            <TabItem Header="{Binding GuildBindings.TranslationGuildOverview, FallbackValue=GUILD_OVERVIEW}">
                <ScrollViewer>
                    <StackPanel Margin="16" Orientation="Vertical">
                        <Border Style="{StaticResource Style.Card}" Padding="24" Visibility="{Binding GuildBindings.GuildOverviewEmptyVisibility}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GuildBindings.TranslationGuildOverviewEmpty, FallbackValue=GUILD_OVERVIEW_EMPTY}"
                                           Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,0,0,14" />
                                <Button Content="{Binding GuildBindings.TranslationGuildOverviewRefresh, FallbackValue=GUILD_OVERVIEW_REFRESH}"
                                        HorizontalAlignment="Center" MinWidth="160" Click="BtnRefreshGuildOverview_Click" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding GuildBindings.GuildOverviewContentVisibility}">
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding GuildBindings.GuildInfo.Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12" Margin="0,4,0,0">
                                            <Run Text="{Binding GuildBindings.TranslationGuildOverviewFounder, Mode=OneWay}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding GuildBindings.GuildInfo.FounderName, Mode=OneWay}" />
                                            <Run Text="    " />
                                            <Run Text="{Binding GuildBindings.TranslationGuildOverviewFounded, Mode=OneWay}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding GuildBindings.GuildInfo.Founded, StringFormat=d, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding GuildBindings.TranslationGuildOverviewRefresh, FallbackValue=GUILD_OVERVIEW_REFRESH}"
                                            VerticalAlignment="Top" MinWidth="120" Click="BtnRefreshGuildOverview_Click" />
                                </Grid>
                            </Border>

                            <WrapPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildOverviewMembers, FallbackValue=GUILD_OVERVIEW_MEMBERS}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.GuildInfo.MemberCount}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildOverviewKillFame, FallbackValue=GUILD_OVERVIEW_KILL_FAME}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.GuildInfo.KillFame, StringFormat={}{0:N0}}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildOverviewDeathFame, FallbackValue=GUILD_OVERVIEW_DEATH_FAME}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.GuildInfo.DeathFame, StringFormat={}{0:N0}}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildOverviewAlliance, FallbackValue=GUILD_OVERVIEW_ALLIANCE}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.GuildInfo.AllianceTag}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Style.Card}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding GuildBindings.TranslationGuildOverviewRanking, FallbackValue=GUILD_OVERVIEW_RANKING}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding GuildBindings.GuildMembers}" ItemTemplate="{StaticResource GuildOverview.MemberRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding GuildBindings.TranslationBattleReport, FallbackValue=BATTLE_REPORT}">
                <ScrollViewer>
                    <StackPanel Margin="16" Orientation="Vertical">
                        <Border Style="{StaticResource Style.Card}" Padding="24" Visibility="{Binding GuildBindings.BattleReportEmptyStateVisibility}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GuildBindings.TranslationBattleReportEmpty, FallbackValue=BATTLE_REPORT_EMPTY}"
                                           Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding GuildBindings.BattleReportMvpVisibility}">
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SolidColorBrush.Hover}" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding GuildBindings.BattleReportMvp.NameInitial}" FontWeight="Bold" FontSize="18"
                                                   Foreground="{StaticResource SolidColorBrush.Text.1}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GuildBindings.TranslationBattleReportMvp, FallbackValue=MVP}"
                                                   Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GuildBindings.BattleReportMvp.Name}" Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Foreground="{StaticResource SolidColorBrush.TextSecondary}" FontSize="12">
                                            <Run Text="{Binding GuildBindings.BattleReportMvp.DamageShortString, Mode=OneWay}" />
                                            <Run Text=" dmg" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationBattleReportMembers, FallbackValue=BATTLE_REPORT_MEMBERS}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.BattleReportMembers.Count}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static damageMeter:DamageMeterBindings.TranslationTotalDamage}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.BattleReportTotalDamage, StringFormat={}{0:N0}}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static damageMeter:DamageMeterBindings.TranslationTotalHealing}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.BattleReportTotalHealing, StringFormat={}{0:N0}}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Style.Card}" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding GuildBindings.TranslationBattleReportTopContributors, FallbackValue=BATTLE_REPORT_TOP_CONTRIBUTORS}"
                                               Foreground="{StaticResource SolidColorBrush.Text.1}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <wpf:CartesianChart Series="{Binding GuildBindings.SeriesBattleReportContribution}"
                                                        XAxes="{Binding GuildBindings.XAxesBattleReportContribution}"
                                                        YAxes="{Binding GuildBindings.YAxesBattleReportContribution}"
                                                        Height="240" Background="Transparent" LegendPosition="Top" AnimationsSpeed="0:0:0.4" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding GuildBindings.BattleReportMembers}" ItemTemplate="{StaticResource DamageMeterFragmentTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding GuildBindings.TranslationGuildLootCheck, FallbackValue=GUILD_LOOT_CHECK}">
                <ScrollViewer>
                    <StackPanel Margin="16" Orientation="Vertical">
                        <Border Style="{StaticResource Style.Card}" Padding="24" Visibility="{Binding GuildBindings.LootCheckEmptyVisibility}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GuildBindings.TranslationGuildLootCheckEmpty, FallbackValue=GUILD_LOOT_CHECK_EMPTY}"
                                           Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,0,0,14" />
                                <Button Content="{Binding GuildBindings.TranslationGuildLootCheckRefresh, FallbackValue=GUILD_LOOT_CHECK_REFRESH}"
                                        HorizontalAlignment="Center" MinWidth="160" Click="BtnRefreshLootCheck_Click" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding GuildBindings.LootCheckContentVisibility}">
                            <WrapPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildLootCheckResolved, FallbackValue=GUILD_LOOT_CHECK_RESOLVED}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.LootCheckResolvedCount}" Style="{StaticResource PlayerAnalysis.StatValue}" Foreground="{StaticResource SolidColorBrush.Accent.Green.3}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildLootCheckLost, FallbackValue=GUILD_LOOT_CHECK_LOST}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.LootCheckLostCount}" Style="{StaticResource PlayerAnalysis.StatValue}" Foreground="{StaticResource SolidColorBrush.Accent.Red.3}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildLootCheckUnknown, FallbackValue=GUILD_LOOT_CHECK_UNKNOWN}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.LootCheckUnknownCount}" Style="{StaticResource PlayerAnalysis.StatValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PlayerAnalysis.StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuildBindings.TranslationGuildLootCheckDonated, FallbackValue=GUILD_LOOT_CHECK_DONATED}" Style="{StaticResource PlayerAnalysis.StatLabel}" />
                                        <TextBlock Text="{Binding GuildBindings.LootCheckDonatedCount}" Style="{StaticResource PlayerAnalysis.StatValue}" Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Style.Card}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GuildBindings.TranslationGuildLootCheckHint, FallbackValue=GUILD_LOOT_CHECK_HINT}"
                                               Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{Binding GuildBindings.TranslationGuildLootCheckRefresh, FallbackValue=GUILD_LOOT_CHECK_REFRESH}"
                                            MinWidth="120" Click="BtnRefreshLootCheck_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding GuildBindings.TranslationSiphonedEnergy, FallbackValue=SIPHONED_ENERGY}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="{Binding VaultBindings.GridSplitterPosition ,Mode=TwoWay, FallbackValue=*}"/>
                    </Grid.RowDefinitions>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Margin="0,0,1,1" Background="{StaticResource SolidColorBrush.Accent.Blue.4}" />

                    <Grid Row="0" Margin="0,0,0,6" Grid.RowSpan="2">
                        <Grid Height="66" VerticalAlignment="Top">
                            <StackPanel Orientation="Vertical" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,3,0">
                                <StackPanel Orientation="Horizontal" MaxWidth="300" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Content="{Binding GuildBindings.TranslationDeleteSelectedEntries, FallbackValue=DELETE__SELECTED__ENTRIES}" Margin="5,0,0,0"
                                        Height="24" Width="200" MaxWidth="300" MinWidth="200" IsEnabled="{Binding TradeMonitoringBindings.IsDeleteTradesButtonEnabled}" 
                                        Style="{StaticResource Style.Button.Danger}" Click="BtnDeleteSelectedSiphonedEnergyEntries_Click" />
                                    <Grid Height="20" Width="20" Margin="5,0,0,0" VerticalAlignment="Center"
                                          MouseEnter="OpenSiphonedEnergyInfoPopup_MouseEnter" MouseLeave="CloseSiphonedEnergyInfoPopup_MouseLeave">
                                        <fa5:ImageAwesome Icon="Solid_InfoCircle" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Content="{Binding GuildBindings.TranslationSelectDeselectAll, FallbackValue=SELECT__DESELECT__ALL}" Margin="5,0,25,0"
                                        Height="24" Width="200" MaxWidth="300" MinWidth="200" Click="BtnSelectSwitchAllSiphonedEnergyEntries_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Margin="0,5"
                                        Visibility="{Binding GuildBindings.SiphonedEnergyLastUpdateVisibility}">
                                <TextBlock Text="{Binding GuildBindings.TranslationLastUpdate, StringFormat='{}{0:N0}: ', FallbackValue=LAST_UPDATE:}" FontSize="12" 
                                           Foreground="{StaticResource SolidColorBrush.Text.4}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GuildBindings.SiphonedEnergyLastUpdate, StringFormat='{}{0} UTC', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=00:00:00}" 
                                           FontSize="12" Foreground="{StaticResource SolidColorBrush.Text.4}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource SolidColorBrush.Background.2}" Height="4" Margin="0,66,0,0" VerticalAlignment="Top"/>
                        <Grid Margin="0,68,0,192" VerticalAlignment="Stretch">
                            <vwp:VirtualizingItemsControl ItemsSource="{Binding GuildBindings.SiphonedEnergyOverviewList, IsAsync=True, Mode=OneWay}" 
                                                          MinHeight="240" 
                                                          Height="auto"
                                                          VerticalContentAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          ItemTemplate="{StaticResource SiphonedEnergyOverviewItemTemplate}" 
                                                          Background="{StaticResource SolidColorBrush.Accent.Blue.Transparent.5}"
                                                          VirtualizingPanel.CacheLengthUnit="Item"
                                                          VirtualizingPanel.CacheLength="10,10"
                                                          VirtualizingPanel.ScrollUnit="Pixel"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Visible" />
                        </Grid>

                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="28" Margin="0,10,20,0">
                                <TextBlock Text="{Binding GuildBindings.TranslationTotal, StringFormat='{}{0:N0}: ', FallbackValue='TOTAL: '}" FontSize="12" 
                                           Foreground="{StaticResource SolidColorBrush.Text.4}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GuildBindings.TotalSiphonedEnergyQuantity, StringFormat='{}{0} ', FallbackValue=0}" FontSize="12" 
                                           Foreground="{StaticResource SolidColorBrush.Text.4}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ContentControl ContentTemplate="{StaticResource ManuallySiphonedEnergy.Template}" 
                                            Content="{Binding GuildBindings.ManuallySiphonedEnergy}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                    <Grid Row="2">
                        <vwp:VirtualizingItemsControl Margin="0,0,0,0" ItemsSource="{Binding GuildBindings.SiphonedEnergyCollectionView, IsAsync=True, Mode=OneWay}" 
                                                      ItemTemplate="{StaticResource SiphonedEnergyItemTemplate}"
                                                      d:ItemsSource="{d:SampleData ItemCount=10}"
                                                      VirtualizingPanel.CacheLengthUnit="Item"
                                                      VirtualizingPanel.CacheLength="10,10"
                                                      VirtualizingPanel.ScrollUnit="Pixel"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Visible" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Visibility="{Binding GuildBindings.GuildPopupVisibility, FallbackValue=Collapsed}" 
              Margin="0,60,0,0" Background="{StaticResource SolidColorBrush.Background.2}">
            <StackPanel CanHorizontallyScroll="False" CanVerticallyScroll="True" Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription1}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription2}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription3}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                        <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </Grid>
                    <TextBlock Text="{Binding Translation.SiphonedEnergyDescription4}" Foreground="{StaticResource SolidColorBrush.Text.1}" 
                                   FontSize="16" TextWrapping="Wrap" Width="auto" />
                </StackPanel>
                <Image Margin="0,10" Source="../Assets/siphoned_energy_description01.jpg" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>