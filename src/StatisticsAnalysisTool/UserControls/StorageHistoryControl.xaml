<UserControl x:Class="StatisticsAnalysisTool.UserControls.StorageHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:gl="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <UserControl.Resources>
        <Style x:Key="StorageHistory.StatCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Panel}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="{Binding VaultBindings.GridSplitterPosition ,Mode=TwoWay, FallbackValue=*}"/>
        </Grid.RowDefinitions>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4"
                      Background="{StaticResource SolidColorBrush.Hover}" />

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <ComboBox MinHeight="32" Width="225" Margin="0,0,10,0" ItemsSource="{Binding VaultBindings.Vaults}" IsSynchronizedWithCurrentItem="True"
                              SelectedItem="{Binding VaultBindings.VaultSelected}" DisplayMemberPath="LocationDisplayString" />

                    <ComboBox MinHeight="32" Width="225" Margin="0,0,10,0" ItemsSource="{Binding VaultBindings.VaultContainer}" IsSynchronizedWithCurrentItem="True"
                              SelectedItem ="{Binding VaultBindings.VaultContainerSelected, IsAsync=True}" DisplayMemberPath="Name" />

                    <Button Content="{Binding Translation.DeleteCurrentStorage, FallbackValue=DELETE__CURRENT__STORAGE}" Height="32" MinWidth="180"
                            Style="{StaticResource Style.Button.Danger}" Click="ButtonDeleteCurrentStorage_OnClick" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,10"
                            Visibility="{Binding VaultBindings.LastUpdateVisibility}">
                    <TextBlock Text="{Binding Translation.LastUpdate, StringFormat='{}{0:N0}: ', FallbackValue=LAST_UPDATE:}" FontSize="12"
                           Foreground="{StaticResource SolidColorBrush.TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VaultBindings.LastUpdate, StringFormat='{}{0} UTC', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}, FallbackValue=00:00:00}"
                           FontSize="12" Foreground="{StaticResource SolidColorBrush.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <vwp:VirtualizingItemsControl Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" ItemsSource="{Binding VaultBindings.VaultContainerContent, IsAsync=True, Mode=OneWay}" ItemTemplate="{StaticResource ContainerItemTemplate}"
                                          VirtualizingPanel.CacheLengthUnit="Item"
                                          VirtualizingPanel.CacheLength="10,10"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </vwp:VirtualizingItemsControl>

                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                    <Border Style="{StaticResource StorageHistory.StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Title.1}" Text="{Binding Translation.TotalBankValue, FallbackValue=TOTAL__BANK__VALUE}"
                                       Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VaultBindings.TotalVaultValue, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StorageHistory.StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Title.1}" Text="{Binding Translation.TotalChestValue, FallbackValue=TOTAL__CHEST__VALUE}"
                                       Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VaultBindings.TotalContainerValue, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StorageHistory.StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Title.1}" Text="{Binding Translation.TotalWeight, FallbackValue=TOTAL__WEIGHT}"
                                       Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VaultBindings.TotalWeight, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StorageHistory.StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Title.1}" Text="{Binding Translation.CurrentRepairCosts, FallbackValue=CURRENT__REPAIR__COSTS}"
                                       Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VaultBindings.VaultContainerSelected.RepairCosts, StringFormat='{}{0:N0}', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StorageHistory.StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Title.1}" Text="{Binding Translation.ShowTotalAvgPricesOnItem, FallbackValue=SHOW__TOTAL__AVG__PRICES__ON__ITEM}"
                                       Foreground="{StaticResource SolidColorBrush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <CheckBox IsChecked="{Binding VaultBindings.IsAveragePricesDisplayedOnItem}" HorizontalContentAlignment="Left"
                                      VerticalAlignment="Top" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Style.Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <fa5:ImageAwesome Icon="Solid_Filter" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding VaultBindings.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" MinHeight="32" HorizontalAlignment="Left" />
                </StackPanel>
                <vwp:VirtualizingItemsControl Grid.Row="1" ItemsSource="{Binding VaultBindings.VaultSearchCollectionView, IsAsync=True, Mode=OneWay}"
                                              ItemTemplate="{StaticResource VaultSearchItemTemplate}"
                                              VirtualizingPanel.CacheLengthUnit="Item"
                                              VirtualizingPanel.CacheLength="10,10"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
