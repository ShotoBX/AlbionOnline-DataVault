<UserControl x:Class="StatisticsAnalysisTool.UserControls.TradeMonitoringControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:viewModels="clr-namespace:StatisticsAnalysisTool.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:trade="clr-namespace:StatisticsAnalysisTool.Trade"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DesignHeight="1950" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">
    <UserControl.Resources>
        <trade:TradeDataTemplateSelector x:Key="TradeDataTemplateSelector"
                                         MailMarketplaceBuyOrderExpiredTemplate="{StaticResource MailMarketplaceBuyOrderExpiredTemplate}"
                                         MailMarketplaceBuyOrderFinishedTemplate="{StaticResource MailMarketplaceBuyOrderFinishedTemplate}"
                                         MailMarketplaceSellOrderExpiredTemplate="{StaticResource MailMarketplaceSellOrderExpiredTemplate}"
                                         MailMarketplaceSellOrderFinishedTemplate="{StaticResource MailMarketplaceSellOrderFinishedTemplate}"
                                         InstantSellTemplate="{StaticResource InstantSellTemplate}"
                                         InstantBuyTemplate="{StaticResource InstantBuyTemplate}"
                                         ManualSellTemplate="{StaticResource ManualSellTemplate}"
                                         ManualBuyTemplate="{StaticResource ManualBuyTemplate}"
                                         CraftingTemplate="{StaticResource CraftingTemplate}"
                                         PlayerTradeTemplate="{StaticResource PlayerTradeTemplate}" />

        <Style x:Key="TradeMonitoring.DatePicker" TargetType="{x:Type DatePicker}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Hover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Hover}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TradeMonitoring.RankingRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SolidColorBrush.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TradeItemRankingEntryTemplate" DataType="{x:Type trade:TradeItemRankingEntry}">
            <Border Style="{StaticResource TradeMonitoring.RankingRow}" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding RankDisplay}" Foreground="{StaticResource SolidColorBrush.Text.3}" VerticalAlignment="Top" />

                    <Border Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                        <Image Source="{Binding ItemIcon}" Width="38" Height="38" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="2" Margin="5,0,0,0" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TierLevelDisplay}" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                            <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource SolidColorBrush.Text.2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding HighlightValueDisplay}" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlightValueNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TradeTransferRankingEntryTemplate" DataType="{x:Type trade:TradeItemRankingEntry}">
            <Border Style="{StaticResource TradeMonitoring.RankingRow}" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding RankDisplay}" Foreground="{StaticResource SolidColorBrush.Text.3}" VerticalAlignment="Top" />

                    <Border Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                        <Image Source="{Binding ItemIcon}" Width="38" Height="38" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="2" Margin="5,0,0,0" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TransferQuantityPrefixDisplay}" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                            <TextBlock Text="{Binding TierLevelDisplay}" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                            <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource SolidColorBrush.Text.2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding HighlightValueDisplay}" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Green.3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlightValueNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.3}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TradeVolumeRankingEntryTemplate" DataType="{x:Type trade:TradeItemRankingEntry}">
            <Border Style="{StaticResource TradeMonitoring.RankingRow}" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding RankDisplay}" Foreground="{StaticResource SolidColorBrush.Text.3}" VerticalAlignment="Top" />

                    <Border Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                        <Image Source="{Binding ItemIcon}" Width="38" Height="38" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="2" Margin="5,0,0,0" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TierLevelDisplay}" Margin="0,0,5,0" FontWeight="SemiBold" Foreground="{StaticResource SolidColorBrush.Text.2}" />
                            <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource SolidColorBrush.Text.2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding HighlightValueDisplay}" Margin="0,2,0,0" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <fa5:ImageAwesome Icon="Solid_Filter" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding TradeMonitoringBindings.TradesSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchText_TextChanged"
                             Width="220" MinHeight="32" HorizontalAlignment="Left" />
                    <fa5:ImageAwesome Icon="Solid_Redo" Foreground="{StaticResource SolidColorBrush.Text.1}" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                      MouseUp="FilterReset_MouseUp" Cursor="Hand" />
                    <fa5:ImageAwesome Visibility="{Binding TradeMonitoringBindings.FilteringIsRunningIconVisibility}" Margin="10,0,0,0" Height="16"
                                      Style="{StaticResource LoadingIconStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="{Binding Translation.DeleteSelectedTrades, FallbackValue=DELETE__SELECTED__TRADES}" Style="{StaticResource Style.Button.Danger}"
                                Height="32" MinWidth="180" IsEnabled="{Binding TradeMonitoringBindings.IsDeleteTradesButtonEnabled}" Click="BtnDeleteSelectedMails_Click" />
                        <Grid Height="20" Width="20" Margin="8,0,0,0" VerticalAlignment="Center"
                              MouseEnter="OpenMailMonitoringPopup_MouseEnter" MouseLeave="CloseMailMonitoringPopup_MouseLeave">
                            <fa5:ImageAwesome Icon="Solid_InfoCircle" Foreground="{StaticResource SolidColorBrush.Text.1}" />
                        </Grid>
                    </StackPanel>
                    <Button Content="{Binding Translation.SelectDeselectAll, FallbackValue=SELECT__DESELECT__ALL}" HorizontalAlignment="Right"
                            Height="32" MinWidth="180" Click="BtnSelectSwitchAllMails_Click" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <ComboBox Width="80" MinHeight="32" Margin="0,0,10,0"
                              ItemsSource="{Binding TradeMonitoringBindings.TierFilters}"
                              SelectedValue="{Binding TradeMonitoringBindings.SelectedTierFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="FilterSelection_OnSelectionChanged" />
                    <ComboBox Width="90" MinHeight="32" Margin="0,0,10,0"
                              ItemsSource="{Binding TradeMonitoringBindings.LevelFilters}"
                              SelectedValue="{Binding TradeMonitoringBindings.SelectedLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="FilterSelection_OnSelectionChanged" />
                    <ComboBox Width="170" MinHeight="32" Margin="0,0,20,0"
                              ItemsSource="{Binding TradeMonitoringBindings.LocationFilters}"
                              SelectedValue="{Binding TradeMonitoringBindings.SelectedLocationFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="FilterSelection_OnSelectionChanged" />
                    <DatePicker SelectedDate="{Binding TradeMonitoringBindings.DatePickerTradeFrom}" SelectedDateChanged="DatePicker_OnSelectedDateChanged"
                                Style="{StaticResource TradeMonitoring.DatePicker}" />
                    <TextBlock Text="{Binding Translation.To, StringFormat='{}{0} ', FallbackValue=TO}" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush.TextSecondary}" Margin="8,0" />
                    <DatePicker SelectedDate="{Binding TradeMonitoringBindings.DatePickerTradeTo}" SelectedDateChanged="DatePicker_OnSelectedDateChanged"
                                Style="{StaticResource TradeMonitoring.DatePicker}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="{Binding Translation.TradeOverview, FallbackValue=TRADE_OVERVIEW}">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="{Binding TradeMonitoringBindings.GridSplitterPosition ,Mode=TwoWay, FallbackValue=*}"/>
                        </Grid.RowDefinitions>

                        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4"
                                      Background="{StaticResource SolidColorBrush.Hover}" />

                        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Style.Card}" Padding="18">
                            <Grid>
                                <ScrollViewer>
                                    <StackPanel Orientation="Vertical">
                                        <ContentControl ContentTemplate="{StaticResource MailStatsObjectTemplate}" Content="{Binding TradeMonitoringBindings.TradeStatsObject}" />
                                        <ContentControl ContentTemplate="{StaticResource MailOptionsObjectTemplate}" Content="{Binding TradeMonitoringBindings.TradeOptionsObject}" />
                                        <ContentControl ContentTemplate="{StaticResource ManuallyMailMenuTemplate}" Content="{Binding TradeMonitoringBindings.ManuallyTradeMenuObject}" />
                                        <ContentControl ContentTemplate="{StaticResource TradeExportTemplate}" Content="{Binding TradeMonitoringBindings.TradeExportTemplateObject}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Height="28" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Margin="0,0,10,0" Foreground="{StaticResource SolidColorBrush.TextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}" FallbackValue="0 / 0">
                                                <Binding Path="TradeMonitoringBindings.CurrentTradeCounts" IsAsync="True" Mode="OneWay" />
                                                <Binding Path="TradeMonitoringBindings.TotalTradeCounts" IsAsync="True" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Grid Height="16" Width="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <fa5:ImageAwesome Icon="Solid_ListAlt" Foreground="{StaticResource SolidColorBrush.TextSecondary}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Style.Card}" Padding="18">
                            <vwp:VirtualizingItemsControl ItemsSource="{Binding TradeMonitoringBindings.TradeCollectionView, IsAsync=True, Mode=OneWay}"
                                                          ItemTemplateSelector="{StaticResource TradeDataTemplateSelector}"
                                                          VirtualizingPanel.CacheLengthUnit="Item"
                                                          VirtualizingPanel.CacheLength="10,10"
                                                          VirtualizingPanel.ScrollUnit="Pixel"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Visible" />
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding Translation.Diagrams, FallbackValue=DIAGRAMS}">
                    <ScrollViewer x:Name="DiagramsScrollViewer"
                                  Margin="0,14,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding TradeMonitoringBindings.ProfitOverTimeChartTitle, FallbackValue=PROFIT_OVER_TIME}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                               FontSize="15"
                                               FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <ComboBox Width="140"
                                                  MinHeight="32"
                                                  ItemsSource="{Binding TradeMonitoringBindings.ProfitOverTimeAggregationFilters}"
                                                  SelectedValue="{Binding TradeMonitoringBindings.SelectedProfitOverTimeAggregation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectionChanged="ProfitOverTimeAggregation_OnSelectionChanged" />
                                    </StackPanel>

                                    <Border Grid.Row="2" Height="320">
                                        <wpf:CartesianChart Series="{Binding TradeMonitoringBindings.ProfitOverTimeSeries}"
                                                            XAxes="{Binding TradeMonitoringBindings.ProfitOverTimeXAxes}"
                                                            YAxes="{Binding TradeMonitoringBindings.ProfitOverTimeYAxes}"
                                                            TooltipPosition="Center"
                                                            FindingStrategy="ExactMatchTakeClosest"
                                                            LegendPosition="Hidden"
                                                            Background="Transparent"
                                                            PreviewMouseWheel="DiagramsChart_OnPreviewMouseWheel"
                                                            DrawMarginFrame="{x:Null}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Style.Card}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding TradeMonitoringBindings.ProfitByTimeOfDayChartTitle, FallbackValue=PROFIT_BY_TIME_OF_DAY}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}"
                                               FontSize="15"
                                               FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                        <ComboBox Width="140"
                                                  MinHeight="32"
                                                  ItemsSource="{Binding TradeMonitoringBindings.ProfitByTimeOfDayChartModeFilters}"
                                                  SelectedValue="{Binding TradeMonitoringBindings.SelectedProfitByTimeOfDayChartMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectionChanged="ProfitByTimeOfDayChartMode_OnSelectionChanged" />
                                        <ComboBox Width="210"
                                                  MinHeight="32"
                                                  Margin="10,0,0,0"
                                                  ItemsSource="{Binding TradeMonitoringBindings.ProfitByTimeOfDayMetricFilters}"
                                                  SelectedValue="{Binding TradeMonitoringBindings.SelectedProfitByTimeOfDayMetric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Value"
                                                  SelectionChanged="ProfitByTimeOfDayMetric_OnSelectionChanged" />
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Border Height="380"
                                                Visibility="{Binding TradeMonitoringBindings.ProfitByTimeOfDayHeatmapVisibility}">
                                            <skia:SKElement x:Name="ProfitByTimeOfDayHeatmap"
                                                            PaintSurface="ProfitByTimeOfDayHeatmap_OnPaintSurface"
                                                            MouseMove="ProfitByTimeOfDayHeatmap_OnMouseMove"
                                                            MouseLeave="ProfitByTimeOfDayHeatmap_OnMouseLeave"
                                                            PreviewMouseWheel="DiagramsChart_OnPreviewMouseWheel" />
                                        </Border>

                                        <Border Height="380"
                                                Visibility="{Binding TradeMonitoringBindings.ProfitByTimeOfDayBarChartVisibility}">
                                            <wpf:CartesianChart Series="{Binding TradeMonitoringBindings.ProfitByTimeOfDaySeries}"
                                                                XAxes="{Binding TradeMonitoringBindings.ProfitByTimeOfDayXAxes}"
                                                                YAxes="{Binding TradeMonitoringBindings.ProfitByTimeOfDayYAxes}"
                                                                TooltipPosition="Center"
                                                                FindingStrategy="ExactMatchTakeClosest"
                                                                LegendPosition="Hidden"
                                                                Background="Transparent"
                                                                PreviewMouseWheel="DiagramsChart_OnPreviewMouseWheel"
                                                                DrawMarginFrame="{x:Null}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Translation.TopItemRanking, FallbackValue=TOP_ITEM_RANKING}">
                    <ScrollViewer x:Name="TopItemRankingScrollViewer" Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Translation.TopTransferByProfit, FallbackValue=TOP_TRANSFER_BY_PROFIT}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <ListBox Grid.Row="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             IsTabStop="False"
                                             IsHitTestVisible="False"
                                             ItemsSource="{Binding TradeMonitoringBindings.TopItemsByProfit}"
                                             PreviewMouseWheel="TopItemRankingList_OnPreviewMouseWheel"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemTemplate="{StaticResource TradeTransferRankingEntryTemplate}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Translation.TopTransferByLoss, FallbackValue=TOP_TRANSFER_BY_LOSS}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"
                                             ItemsSource="{Binding TradeMonitoringBindings.TopItemsByLoss}"
                                             PreviewMouseWheel="TopItemRankingList_OnPreviewMouseWheel" IsHitTestVisible="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemTemplate="{StaticResource TradeTransferRankingEntryTemplate}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Translation.TopItemsByRoi, FallbackValue=TOP_ITEMS_BY_ROI}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"
                                             ItemsSource="{Binding TradeMonitoringBindings.TopItemsByRoi}"
                                             PreviewMouseWheel="TopItemRankingList_OnPreviewMouseWheel" IsHitTestVisible="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemTemplate="{StaticResource TradeItemRankingEntryTemplate}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Style.Card}" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Translation.TopSoldItemsByVolume, FallbackValue=TOP_SOLD_ITEMS_BY_VOLUME}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <ListBox Grid.Row="1"
                                             Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"
                                             ItemsSource="{Binding TradeMonitoringBindings.TopSoldItemsByVolume}"
                                             PreviewMouseWheel="TopItemRankingList_OnPreviewMouseWheel" IsHitTestVisible="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemTemplate="{StaticResource TradeVolumeRankingEntryTemplate}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Style.Card}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Translation.TopBoughtItemsByVolume, FallbackValue=TOP_BOUGHT_ITEMS_BY_VOLUME}"
                                               Foreground="{StaticResource SolidColorBrush.Accent.Blue.2}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                                    <ListBox Grid.Row="1"
                                             Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False"
                                             ItemsSource="{Binding TradeMonitoringBindings.TopBoughtItemsByVolume}"
                                             PreviewMouseWheel="TopItemRankingList_OnPreviewMouseWheel" IsHitTestVisible="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemTemplate="{StaticResource TradeVolumeRankingEntryTemplate}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Visibility="{Binding TradeMonitoringBindings.IsTradeMonitoringPopupVisible, FallbackValue=Hidden}"
                    Margin="0,44,0,0" Background="{StaticResource SolidColorBrush.Card}" CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource SolidColorBrush.Hover}" BorderThickness="1">
                <StackPanel CanHorizontallyScroll="False" CanVerticallyScroll="True" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <DockPanel>
                        <Grid Height="16" Width="16" Margin="0,3,10,0" VerticalAlignment="Top">
                            <fa5:ImageAwesome Icon="Regular_DotCircle" Foreground="{StaticResource SolidColorBrush.Accent.Blue.3}" />
                        </Grid>
